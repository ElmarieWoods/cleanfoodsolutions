{% comment %}
  Template: Our Journey Page
  Uses sections to build the complete page layout matching the original design
{% endcomment %}

{% layout 'theme' %}

<!-- Hero Section -->
<section class="journey-hero-section">
  <div class="hero-container">
    <div class="hero-content">
      <!-- Hero Image -->
      <div class="hero-image">
        {% if page.metafields.custom.hero_image %}
          <img
            src="{{ page.metafields.custom.hero_image | img_url: '662x441' }}"
            alt="{{ page.metafields.custom.hero_image_alt | default: 'Our Journey Hero' }}"
            class="hero-img"
          >
        {% else %}
          <div class="hero-placeholder"></div>
        {% endif %}
      </div>

      <!-- Hero Title -->
      <div class="hero-title">
        <h1>{{ page.metafields.custom.hero_title | default: 'Our Journey' }}</h1>
      </div>
    </div>
  </div>
</section>

<!-- Mission Statement Section -->
<section class="mission-statement-section">
  <div class="mission-container">
    <div class="mission-content">
      <p class="mission-text">
        {{
          page.metafields.custom.mission_text
          | default: 'After seeing countless families cycle through restrictive diets with limited relief, Susan turned to the deeper question:'
        }}
      </p>
      <p class="mission-question">
        {{
          page.metafields.custom.mission_question
          | default: "Could there be something hidden in our foods that's making us sick beyond what labels or trends tell us?"
        }}
      </p>
    </div>
  </div>
</section>

<!-- Include existing sections -->
{% section 'mycotoxin-research' %}
{% section 'journey-timeline' %}
{% section 'mission-today' %}

<!-- Page Content (if any additional content) -->
{% if page.content != blank %}
  <section class="page-content">
    <div class="content-container">
      {{ page.content }}
    </div>
  </section>
{% endif %}

<style>
  /* Journey Hero Section */
  .journey-hero-section {
    width: 100vw;
    margin: 0;
    padding: 0;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: #e3f4f4;
    overflow: hidden;
  }

  .hero-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 144px;
    box-sizing: border-box;
  }

  .hero-content {
    display: flex;
    align-items: center;
    gap: 40px;
    min-height: 441px;
    padding: 40px 0;
  }

  .hero-image {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-img {
    width: 662px;
    height: 441px;
    object-fit: cover;
    border-radius: 8px;
    transform: scaleY(-1) rotate(180deg);
  }

  .hero-placeholder {
    width: 662px;
    height: 441px;
    background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
    border-radius: 8px;
  }

  .hero-title {
    flex: 1;
    text-align: center;
  }

  .hero-title h1 {
    font-family: var(--font-primary);
    font-size: 48px;
    font-weight: var(--font-weight-regular);
    color: #374151;
    margin: 0;
    line-height: 1.2;
  }

  /* Mission Statement Section */
  .mission-statement-section {
    width: 100vw;
    margin: 0;
    padding: 0;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: #e3f4f4;
  }

  .mission-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 71px 144px;
    box-sizing: border-box;
  }

  .mission-content {
    max-width: 1152px;
    margin: 0 auto;
  }

  .mission-text {
    font-family: var(--font-primary);
    font-size: 40px;
    font-weight: var(--font-weight-regular);
    color: #ec4899;
    margin: 0 0 20px 0;
    line-height: 1.3;
  }

  .mission-question {
    font-family: var(--font-primary);
    font-size: 40px;
    font-weight: var(--font-weight-bold);
    color: #ec4899;
    margin: 0;
    line-height: 1.3;
  }

  /* Page Content */
  .page-content {
    padding: 80px 0;
    background: #ffffff;
  }

  .content-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Responsive Design */
  @media (max-width: 1440px) {
    .hero-container,
    .mission-container {
      padding-left: clamp(20px, 10vw, 144px);
      padding-right: clamp(20px, 10vw, 144px);
    }

    .hero-title h1 {
      font-size: clamp(32px, 4vw, 48px);
    }

    .mission-text,
    .mission-question {
      font-size: clamp(24px, 3vw, 40px);
    }
  }

  @media (max-width: 1024px) {
    .hero-content {
      flex-direction: column;
      text-align: center;
      gap: 32px;
    }

    .hero-img,
    .hero-placeholder {
      width: 100%;
      max-width: 500px;
      height: 300px;
    }

    .mission-container {
      padding: 40px 20px;
    }
  }

  @media (max-width: 768px) {
    .hero-container,
    .mission-container {
      padding-left: 16px;
      padding-right: 16px;
    }

    .hero-content {
      min-height: auto;
      padding: 32px 0;
    }

    .hero-img,
    .hero-placeholder {
      height: 250px;
    }

    .mission-container {
      padding: 32px 16px;
    }
  }

  @media (max-width: 480px) {
    .hero-content {
      padding: 24px 0;
    }

    .hero-img,
    .hero-placeholder {
      height: 200px;
    }

    .mission-container {
      padding: 24px 12px;
    }
  }
</style>
