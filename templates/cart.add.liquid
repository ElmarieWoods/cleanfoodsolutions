{%- comment -%}
  The cart template renders the cart page.
  More info on cart templates: https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{%- endcomment -%}

<div class="cart-template-wrapper">
  {% section 'main-cart' %}
</div>

<style>
  .cart-page {
    padding: 2rem 0 4rem;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .cart-title {
    font-family: 'Mitogen Display', Georgia, serif;
    font-size: 2.5rem;
    margin-bottom: 2rem;
    text-align: center;
    color: #1f2937;
  }

  .cart-empty {
    text-align: center;
    padding: 4rem 0;
  }

  .cart-empty-icon {
    margin-bottom: 1rem;
    color: #9ca3af;
  }

  .cart-empty p {
    font-family: 'Serotiva', sans-serif;
    font-size: 1.125rem;
    color: #6b7280;
    margin-bottom: 2rem;
  }

  .cart-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    padding: 2rem 0;
    border-bottom: 1px solid #e0e0e0;
    position: relative;
  }

  .cart-item:last-child {
    border-bottom: none;
  }

  .cart-item__media {
    width: 150px;
    height: 150px;
  }

  .cart-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .cart-item__image-placeholder {
    width: 100%;
    height: 100%;
    background: #f9fafb;
    border: 2px dashed #d1d5db;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
  }

  .cart-item__details {
    min-width: 0;
  }

  .cart-item__name {
    font-family: 'Serotiva', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .cart-item__name a {
    text-decoration: none;
    color: #1f2937;
    transition: color 0.2s ease;
  }

  .cart-item__name a:hover {
    color: #ec4899;
  }

  .cart-item__variant {
    font-family: 'Serotiva', sans-serif;
    font-size: 0.875rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
  }

  .cart-item__price,
  .cart-item__final-price {
    font-family: 'Serotiva', sans-serif;
    font-weight: 600;
    color: #ec4899;
    margin-bottom: 1rem;
  }

  .cart-item__old-price {
    text-decoration: line-through;
    color: #9ca3af;
    margin-right: 0.5rem;
  }

  .cart-item__options {
    margin-bottom: 1rem;
  }

  .cart-item__option {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    font-family: 'Serotiva', sans-serif;
    font-size: 0.875rem;
  }

  .cart-item__option dt {
    font-weight: 600;
    color: #374151;
  }

  .cart-item__option dd {
    color: #6b7280;
  }

  .cart-item__quantity {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #ffffff;
  }

  .quantity-selector__button {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    transition: all 0.2s ease;
  }

  .quantity-selector__button:hover {
    background: #f3f4f6;
    color: #1f2937;
  }

  .quantity-selector__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .quantity-selector__input {
    border: none;
    text-align: center;
    width: 60px;
    height: 40px;
    font-family: 'Serotiva', sans-serif;
    font-weight: 500;
    color: #1f2937;
  }

  .cart-item__remove {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #ef4444;
    border-radius: 4px;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Serotiva', sans-serif;
    font-size: 0.875rem;
  }

  .cart-item__remove:hover {
    background: #fef2f2;
    color: #dc2626;
  }

  .cart-item__remove-text {
    display: none;
  }

  .cart-item__totals {
    text-align: right;
  }

  .cart-item__price-wrapper .price {
    font-family: 'Serotiva', sans-serif;
    font-weight: 600;
    font-size: 1.125rem;
    color: #1f2937;
  }

  .unit-price {
    font-family: 'Serotiva', sans-serif;
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.25rem;
  }

  .cart-summary {
    background: #f9fafb;
    padding: 2rem;
    border-radius: 8px;
    margin-top: 2rem;
  }

  .cart-summary__total {
    display: flex;
    justify-content: space-between;
    font-family: 'Serotiva', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #1f2937;
  }

  .cart-summary__price {
    color: #ec4899;
  }

  .cart-summary__buttons {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .button {
    padding: 1rem 2rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-family: 'Serotiva', sans-serif;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    flex: 1;
    transition: all 0.2s ease;
  }

  .button--primary {
    background-color: #ec4899;
    color: white;
  }

  .button--primary:hover {
    background-color: #db2777;
  }

  .button--secondary {
    background-color: #f0f0f0;
    color: #333;
    border: 1px solid #d1d5db;
  }

  .button--secondary:hover {
    background-color: #e5e7eb;
  }

  .cart-note {
    margin-bottom: 2rem;
  }

  .cart-note label {
    font-family: 'Serotiva', sans-serif;
    font-weight: 600;
    color: #374151;
    display: block;
    margin-bottom: 0.5rem;
  }

  .text-area {
    width: 100%;
    min-height: 100px;
    padding: 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: 'Serotiva', sans-serif;
    resize: vertical;
  }

  .tax-note {
    font-family: 'Serotiva', sans-serif;
    font-size: 0.875rem;
    color: #6b7280;
    margin-top: 1rem;
  }

  .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }

  /* Loading state */
  .cart-item.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .cart-item.loading::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border: 2px solid #ec4899;
    border-top: 2px solid transparent;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .cart-page {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .cart-item {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1rem;
    }

    .cart-item__media {
      width: 120px;
      height: 120px;
      margin: 0 auto;
    }

    .cart-item__details {
      text-align: left;
    }

    .cart-item__quantity {
      align-items: center;
    }

    .cart-item__remove-text {
      display: inline;
    }

    .cart-item__totals {
      text-align: center;
    }

    .cart-summary__buttons {
      flex-direction: column;
    }

    .title-text {
      font-size: 2rem;
    }
  }

  @media (max-width: 480px) {
    .cart-item__media {
      width: 100px;
      height: 100px;
    }

    .quantity-selector__button {
      width: 36px;
      height: 36px;
    }

    .quantity-selector__input {
      width: 50px;
      height: 36px;
    }
  }
</style>
