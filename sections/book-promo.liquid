</section>

<style>
  /* Import Fonts */
  @import url('https://fonts.googleapis.com/css2?family=Mitogen+Display:wght@400;700&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Serotiva:wght@400;700&display=swap');

  /* CSS Custom Properties */
  :root {
    --book-promo-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --book-promo-title: {{ section.settings.title_color | default: '#1f2937' }};
    --book-badge-bg: {{ section.settings.badge_background | default: '#e3f4f4' }};
    --book-icon-color: {{ section.settings.icon_color | default: '#1f2937' }};
    --book-label-color: {{ section.settings.label_color | default: '#1f2937' }};
    --book-value-color: {{ section.settings.value_color | default: '#1f2937' }};
    --book-primary-btn: {{ section.settings.primary_btn_bg | default: '#1f2937' }};
    --book-primary-text: {{ section.settings.primary_btn_text_color | default: '#ffffff' }};
    --book-primary-hover: {{ section.settings.primary_btn_hover | default: '#374151' }};
    --book-secondary-bg: {{ section.settings.secondary_btn_bg | default: '#ffffff' }};
    --book-secondary-text: {{ section.settings.secondary_btn_text_color | default: '#1f2937' }};
    --book-secondary-border: {{ section.settings.secondary_btn_border | default: '#1f2937' }};
    --book-secondary-hover: {{ section.settings.secondary_btn_hover_bg | default: '#f9fafb' }};
    --font-heading: 'Mitogen Display', Georgia, serif;
    --font-body: 'Serotiva', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

    /* FIXED: Seamless spacing - no excessive padding */
    --book-section-padding: clamp(32px, 4vw, 48px);
    --book-container-padding: clamp(16px, 4vw, 32px);
    --book-element-gap: clamp(24px, 3vw, 40px);

    /* Typography */
    --book-title-size: clamp(32px, 4vw, 48px);
    --book-badge-size: clamp(13px, 1.5vw, 14px);

    /* Shadows */
    --book-badge-shadow: -2px 2px 4px 0px rgba(0, 0, 0, 0.25);
    --book-badge-hover-shadow: -2px 4px 8px 0px rgba(0, 0, 0, 0.3);
    --book-btn-shadow: 0 4px 12px rgba(0, 0, 0, 0.15);
  }

  /* FIXED: Book Promo Section - Seamless wrapping */
  .book-promo-section {
    /* Full viewport coverage */
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    /* FIXED: Remove min-height and use auto height */
    background-color: var(--book-promo-bg);
    padding: var(--book-section-padding) 0;
    box-sizing: border-box;
    /* FIXED: Ensure tight wrapping */
    display: flex;
    align-items: stretch;
  }

  .promo-container {
    max-width: min(90vw, 1440px);
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--book-container-padding);
    display: flex;
    flex-direction: column;
    gap: var(--book-element-gap);
    box-sizing: border-box;
    /* FIXED: Ensure container wraps content tightly */
    min-height: auto;
  }

  /* Header */
  .promo-header {
    width: 100%;
    text-align: center;
    /* FIXED: Remove excessive margins */
    margin: 0;
  }

  .promo-title {
    font-family: 'Mitogen Display', serif;
    font-size: var(--book-title-size);
    font-weight: 400;
    line-height: 1.2;
    color: var(--book-promo-title);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* Hero Image Container */
  .promo-hero {
    width: 100%;
    max-width: 1152px;
    margin: 0 auto;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #f8fafc;
    aspect-ratio: 1152 / 705;
  }

  .hero-image-container {
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* Hero Image */
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /* Hero Placeholder */
  .hero-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: #64748b;
    font-family: 'Serotiva', sans-serif;
    z-index: 1;
  }

  .hero-placeholder svg {
    color: #94a3b8;
  }

  .placeholder-text {
    font-size: var(--book-badge-size);
    font-weight: 500;
    margin: 0;
  }

  /* Book Badges */
  .book-badges {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(16px, 3vw, 32px);
    align-items: center;
    justify-content: center;
    width: 100%;
    /* FIXED: Remove excessive margins */
    margin: 0;
  }

  .badge-item {
    background-color: var(--book-badge-bg);
    border-radius: 10px;
    box-shadow: var(--book-badge-shadow);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 11px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
  }

  .badge-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--book-badge-hover-shadow);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Badge Icon */
  .badge-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--book-icon-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .badge-item:hover .badge-icon {
    transform: scale(1.1);
    color: var(--book-primary-btn);
  }

  .badge-label {
    font-family: 'Serotiva', sans-serif;
    font-size: var(--book-badge-size);
    font-weight: 700;
    color: var(--book-label-color);
    white-space: nowrap;
  }

  .badge-value {
    font-family: 'Serotiva', sans-serif;
    font-size: var(--book-badge-size);
    font-weight: 400;
    color: var(--book-value-color);
    white-space: nowrap;
  }

  .badge-values {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .badge-separator {
    font-family: 'Serotiva', sans-serif;
    font-size: var(--book-badge-size);
    color: var(--book-value-color);
    opacity: 0.6;
  }

  /* Product Form */
  .product-form-wrapper {
    max-width: 500px;
    margin: 0 auto;
    background: white;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .product-info {
    text-align: center;
    margin-bottom: 24px;
  }

  .product-title {
    font-family: 'Mitogen Display', serif;
    font-size: 24px;
    font-weight: 600;
    color: var(--book-promo-title);
    margin: 0 0 12px 0;
  }

  .product-price {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .current-price {
    font-size: 20px;
    font-weight: 600;
    color: var(--book-primary-btn);
  }

  .compare-price {
    font-size: 16px;
    color: #9ca3af;
    text-decoration: line-through;
  }

  /* Form Elements */
  .variant-selector,
  .quantity-container {
    margin-bottom: 20px;
  }

  .variant-selector label,
  .quantity-container label {
    display: block;
    font-family: 'Serotiva', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #374151;
    margin-bottom: 8px;
  }

  .variant-select {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-family: 'Serotiva', sans-serif;
    font-size: 16px;
    background: white;
    transition: border-color 0.3s ease;
  }

  .variant-select:focus {
    outline: none;
    border-color: var(--book-primary-btn);
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    width: fit-content;
    margin: 0 auto;
  }

  .quantity-btn {
    background: #f9fafb;
    border: none;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 18px;
    font-weight: 600;
    color: #374151;
    transition: background-color 0.3s ease;
  }

  .quantity-btn:hover {
    background: #f3f4f6;
  }

  .quantity-input {
    border: none;
    width: 60px;
    height: 44px;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    background: white;
  }

  .quantity-input:focus {
    outline: none;
  }

  /* Add to Cart Button */
  .add-to-cart-btn {
    width: 100%;
    background: var(--book-primary-btn);
    color: var(--book-primary-text);
    border: none;
    border-radius: 12px;
    padding: 16px 24px;
    font-family: 'Serotiva', sans-serif;
    font-size: 16px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .add-to-cart-btn:hover:not(:disabled) {
    background: var(--book-primary-hover);
    transform: translateY(-2px);
    box-shadow: var(--book-btn-shadow);
  }

  .add-to-cart-btn:disabled {
    background: #d1d5db;
    color: #9ca3af;
    cursor: not-allowed;
    transform: none;
  }

  .add-to-cart-btn.loading {
    pointer-events: none;
  }

  .add-to-cart-btn.loading .cart-icon {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Purchase Buttons */
  .purchase-buttons {
    display: flex;
    gap: clamp(24px, 6vw, 48px);
    align-items: center;
    justify-content: center;
    width: 100%;
    flex-wrap: wrap;
    /* FIXED: Remove excessive margins */
    margin: 0;
  }

  .purchase-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 10px;
    font-family: 'Serotiva', sans-serif;
    font-size: var(--book-badge-size);
    font-weight: 400;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    min-width: 140px;
    border: 1px solid transparent;
    backdrop-filter: blur(10px);
  }

  .primary-btn {
    background-color: var(--book-primary-btn);
    color: var(--book-primary-text);
    border-color: var(--book-primary-btn);
    display: none; /* PRIMARY BUTTON HIDDEN */
  }

  .primary-btn:hover {
    background-color: var(--book-primary-hover);
    border-color: var(--book-primary-hover);
    transform: translateY(-2px);
    box-shadow: var(--book-btn-shadow);
  }

  .secondary-btn {
    background-color: var(--book-secondary-bg);
    color: var(--book-secondary-text);
    border-color: var(--book-secondary-border);
  }

  .secondary-btn:hover {
    background-color: var(--book-secondary-hover);
    transform: translateY(-2px);
    box-shadow: var(--book-btn-shadow);
  }

  /* FIXED: Responsive Design - Better mobile spacing */
  @media (max-width: 767px) {
    .book-promo-section {
      /* FIXED: Reduce mobile padding */
      padding: clamp(24px, 4vw, 32px) 0;
    }

    .promo-container {
      padding: 0 16px;
      gap: clamp(20px, 4vw, 32px);
    }

    .book-badges {
      gap: 16px;
      justify-content: stretch;
    }

    .badge-item {
      flex: 1;
      min-width: calc(50% - 8px);
      justify-content: center;
      text-align: center;
    }

    .availability-badge,
    .sellers-badge {
      flex-direction: column;
      gap: 8px;
    }

    .badge-values {
      flex-direction: column;
      gap: 4px;
    }

    .badge-separator {
      display: none;
    }

    .purchase-buttons {
      flex-direction: column;
      gap: 20px;
      margin: 0;
    }

    .purchase-btn {
      width: 100%;
      max-width: 280px;
    }

    .product-form-wrapper {
      padding: 24px;
    }
  }

  @media (max-width: 480px) {
    .promo-container {
      padding: 0 12px;
      gap: clamp(16px, 4vw, 24px);
    }

    .book-badges {
      flex-direction: column;
      gap: 12px;
    }

    .badge-item {
      width: 100%;
      min-width: auto;
    }

    /* FIXED: Ensure no extra spacing on small screens */
    .book-promo-section {
      padding: 20px 0;
    }
  }

  /* FIXED: Ensure section doesn't create unwanted spacing */
  .book-promo-section:last-child {
    margin-bottom: 0;
    padding-bottom: var(--book-section-padding);
  }

  /* FIXED: Remove any potential margin collapse issues */
  .book-promo-section * {
    margin-block-start: 0;
    margin-block-end: 0;
  }

  .book-promo-section > *:first-child {
    margin-top: 0;
  }

  .book-promo-section > *:last-child {
    margin-bottom: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('[data-product-form]');
    if (!form) return;

    const variantSelect = form.querySelector('[data-variant-select]');
    const quantityInput = form.querySelector('[data-quantity-input]');
    const addToCartBtn = form.querySelector('[data-add-to-cart]');
    const currentPrice = form.querySelector('[data-price]');
    const comparePrice = form.querySelector('[data-compare-price]');

    // Quantity controls
    form.querySelectorAll('[data-quantity-change]').forEach(btn => {
      btn.addEventListener('click', function() {
        const change = parseInt(this.dataset.quantityChange);
        let currentQty = parseInt(quantityInput.value);
        let newQty = currentQty + change;

        if (newQty >= 1) {
          quantityInput.value = newQty;
        }
      });
    });

    // Variant change handler
    if (variantSelect) {
      variantSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const price = selectedOption.dataset.price;
        const comparePriceValue = selectedOption.dataset.comparePrice;
        const isAvailable = !selectedOption.disabled;

        // Update price display
        if (currentPrice && price) {
          currentPrice.textContent = price;
        }

        if (comparePrice) {
          if (comparePriceValue) {
            comparePrice.textContent = comparePriceValue;
            comparePrice.style.display = 'inline';
          } else {
            comparePrice.style.display = 'none';
          }
        }

        // Update button state
        addToCartBtn.disabled = !isAvailable;
        const buttonText = addToCartBtn.querySelector('.button-text');
        if (isAvailable) {
          buttonText.textContent = 'Add to Cart';
        } else {
          buttonText.textContent = 'Sold Out';
        }
      });
    }

    // Form submission
    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const formData = new FormData(form);
      const variantId = formData.get('id');
      const quantity = parseInt(formData.get('quantity'));

      if (!variantId) {
        alert('Please select a product option');
        return;
      }

      // Update button state
      addToCartBtn.classList.add('loading');
      addToCartBtn.disabled = true;
      const buttonText = addToCartBtn.querySelector('.button-text');
      const originalText = buttonText.textContent;
      buttonText.textContent = 'Adding...';

      try {
        // Add to cart
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: quantity
          })
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.description || 'Failed to add to cart');
        }

        // Success - update cart and show feedback
        buttonText.textContent = 'Added!';
        addToCartBtn.style.background = '#10b981';

        // Dispatch cart update event
        document.dispatchEvent(new CustomEvent('cart:updated'));

        // Open cart drawer if it exists
        const cartDrawer = document.getElementById('cart-drawer');
        const cartOverlay = document.getElementById('cart-drawer-overlay');
        if (cartDrawer && cartOverlay) {
          cartDrawer.classList.add('open');
          cartOverlay.classList.add('open');
          document.body.classList.add('cart-drawer-open');
        }

        // Reset button after delay
        setTimeout(() => {
          buttonText.textContent = originalText;
          addToCartBtn.style.background = '';
          addToCartBtn.classList.remove('loading');
          addToCartBtn.disabled = false;
        }, 2000);

      } catch (error) {
        console.error('Add to cart error:', error);
        alert(error.message || 'Failed to add item to cart');

        // Reset button
        buttonText.textContent = originalText;
        addToCartBtn.classList.remove('loading');
        addToCartBtn.disabled = false;
      }
    });

    // Image loading logic
    const heroImage = document.querySelector('.hero-image');
    const heroPlaceholder = document.querySelector('.hero-placeholder');

    if (heroImage) {
      function showImage() {
        heroImage.style.opacity = '1';
        if (heroPlaceholder) {
          heroPlaceholder.style.display = 'none';
        }
      }

      function showPlaceholder(message = 'Image failed to load') {
        heroImage.style.display = 'none';
        if (heroPlaceholder) {
          heroPlaceholder.style.display = 'flex';
          const placeholderText = heroPlaceholder.querySelector('.placeholder-text');
          if (placeholderText) {
            placeholderText.textContent = message;
          }
        }
      }

      if (heroImage.complete && heroImage.naturalHeight !== 0) {
        showImage();
      } else {
        heroImage.addEventListener('load', showImage);
        heroImage.addEventListener('error', () => showPlaceholder('Image failed to load'));

        setTimeout(() => {
          if (heroImage.style.opacity !== '1') {
            showPlaceholder('Image loading timeout');
          }
        }, 3000);
      }
    }
  });
</script>

