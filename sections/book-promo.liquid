{% comment %}
  Book Promo Section - Get Your Copy Today
  Features: Book badges with custom icons, hero image, purchase buttons, responsive design
  FIXED: Image placeholder logic and updated button icons
  NEW: Add to cart functionality with product selection
  UPDATED: Better external URL handling for Amazon links
  FIXED: Seamless container wrapping without extra whitespace
  FIXED: Date Published badge icon with proper calendar SVG
{% endcomment %}

<section class="book-promo-section" data-section-id="{{ section.id }}">
  <div class="promo-container">
    <!-- Header -->
    <div class="promo-header">
      <h2 class="promo-title">
        {{ section.settings.title | default: 'Get Your Copy Today' }}
      </h2>
    </div>

    <!-- Hero Image - COMPLETELY REWRITTEN -->
    <div class="promo-hero">
      {% if section.settings.hero_image != blank %}
        <div class="hero-image-container">
          <img
            src="{{ section.settings.hero_image | img_url: '1152x705' }}"
            alt="{{ section.settings.hero_image_alt | default: 'Book promotion image' | escape }}"
            class="hero-image"
            loading="lazy"
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1152px"
            srcset="
              {{ section.settings.hero_image | img_url: '576x353' }} 576w,
              {{ section.settings.hero_image | img_url: '768x470' }} 768w,
              {{ section.settings.hero_image | img_url: '1152x705' }} 1152w,
              {{ section.settings.hero_image | img_url: '1440x881' }} 1440w
            "
            onload="this.style.opacity='1'"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
          >
          <div class="hero-placeholder" style="display: none;">
            <svg width="140" height="140" viewBox="0 0 140 140" fill="none" aria-hidden="true">
              <rect width="140" height="140" rx="8" fill="currentColor" opacity="0.1"/>
              <path d="M30 60L45 45L60 60M90 20V60C90 62.2091 88.2091 64 86 64H34C31.7909 64 30 62.2091 30 60V20C30 17.7909 31.7909 16 34 16H86C88.2091 16 90 17.7909 90 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.4"/>
              <circle cx="45" cy="35" r="6" fill="currentColor" opacity="0.4"/>
            </svg>
            <p class="placeholder-text">Image failed to load</p>
          </div>
        </div>
      {% else %}
        <div class="hero-placeholder">
          <svg width="120" height="80" viewBox="0 0 120 120" fill="none" aria-hidden="true">
            <rect width="120" height="120" rx="8" fill="currentColor" opacity="0.1"/>
            <path d="M30 60L45 45L60 60M90 20V60C90 62.2091 88.2091 64 86 64H34C31.7909 64 30 62.2091 30 60V20C30 17.7909 31.7909 16 34 16H86C88.2091 16 90 17.7909 90 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.4"/>
            <circle cx="45" cy="35" r="6" fill="currentColor" opacity="0.4"/>
          </svg>
          <p class="placeholder-text">Add hero image</p>
        </div>
      {% endif %}
    </div>

    <!-- Book Badges -->
    <div class="book-badges">
      <!-- Pages Badge -->
      {% if section.settings.page_count != blank %}
        <div class="badge-item">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.95984 0.918744C11.2188 0.581404 12.5107 1.26868 12.952 2.46855L16.7929 3.49687C18.1485 3.86012 18.9395 5.2682 18.5448 6.61503L16.1444 14.8084C16.1345 14.8421 16.1219 14.8746 16.1083 14.906C15.988 15.888 15.2875 16.7466 14.2733 17.0184L7.83387 18.743C6.50023 19.1002 5.12969 18.309 4.77234 16.9754L1.75281 5.70683C1.39546 4.37316 2.18672 3.00168 3.52039 2.64433L9.95984 0.918744ZM11.412 3.11796C11.2928 2.67365 10.8359 2.4101 10.3915 2.5291L3.95203 4.25468C3.50749 4.3738 3.2431 4.83065 3.36219 5.27519L6.38172 16.5447C6.50097 16.9891 6.95875 17.2527 7.4032 17.1336L13.8427 15.408C14.2869 15.2887 14.5506 14.8319 14.4315 14.3875L11.412 3.11796ZM11.0311 8.78007C11.4751 8.65899 11.9334 8.92016 12.0546 9.36406C12.1757 9.80808 11.9136 10.2664 11.4696 10.3875L6.8866 11.6375C6.44258 11.7586 5.98426 11.4966 5.86316 11.0525C5.74226 10.6086 6.0042 10.1511 6.44812 10.0301L11.0311 8.78007ZM15.3798 11.4891L16.9462 6.14628C17.0776 5.6974 16.813 5.22828 16.3612 5.10722L13.4618 4.32988L15.3798 11.4891ZM10.1981 5.44609C10.642 5.32522 11.0995 5.58718 11.2206 6.03105C11.3417 6.47501 11.0805 6.93332 10.6366 7.05449L6.05262 8.30449C5.60877 8.42528 5.15125 8.16334 5.03016 7.71953C4.90908 7.2756 5.17028 6.8173 5.61414 6.69609L10.1981 5.44609Z" fill="currentColor"/>
            </svg>
          </div>
          <span class="badge-label">Number of pages</span>
          <span class="badge-value">{{ section.settings.page_count | default: '125' }}</span>
        </div>
      {% endif %}

      <!-- Language Badge -->
      {% if section.settings.language != blank %}
        <div class="badge-item">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M3.21191 6.34478H6.82727C7.12644 5.2439 7.52975 4.30808 7.9337 3.55066C8.16758 3.11214 8.40188 2.73299 8.61674 2.41558C6.27729 2.83957 4.30482 4.31944 3.21191 6.34478ZM10.0003 2.63257C9.73683 2.97558 9.38731 3.48139 9.03664 4.1389C8.7119 4.74779 8.38664 5.48576 8.12748 6.34478H11.8732C11.614 5.48576 11.2888 4.74779 10.964 4.1389C10.6133 3.48139 10.2638 2.97558 10.0003 2.63257ZM12.1802 7.59478H7.82047C7.67991 8.32998 7.59502 9.13292 7.59502 10.0001C7.59502 10.8672 7.67991 11.6702 7.82047 12.4054H12.1802C12.3207 11.6702 12.4056 10.8672 12.4056 10.0001C12.4056 9.13292 12.3207 8.32998 12.1802 7.59478ZM13.4508 12.4054C13.5795 11.6623 13.6556 10.8595 13.6556 10.0001C13.6556 9.14066 13.5795 8.33788 13.4508 7.59478H17.3262C17.5743 8.35097 17.7087 9.15929 17.7087 10.0001C17.7087 10.8409 17.5743 11.6492 17.3262 12.4054H13.4508ZM11.8732 13.6554H8.12748C8.38664 14.5144 8.7119 15.2524 9.03664 15.8613C9.38731 16.5188 9.73683 17.0246 10.0003 17.3676C10.2638 17.0246 10.6133 16.5188 10.964 15.8613C11.2888 15.2524 11.614 14.5144 11.8732 13.6554ZM8.61674 17.5846C8.40188 17.2672 8.16758 16.888 7.9337 16.4495C7.52975 15.6921 7.12644 14.7563 6.82727 13.6554H3.21191C4.30481 15.6807 6.27729 17.1606 8.61674 17.5846ZM2.6745 12.4054H6.5499C6.42115 11.6623 6.34502 10.8595 6.34502 10.0001C6.34502 9.14066 6.42115 8.33788 6.5499 7.59478H2.6745C2.42638 8.35097 2.29199 9.15929 2.29199 10.0001C2.29199 10.8409 2.42638 11.6492 2.6745 12.4054ZM11.3839 17.5846C11.5988 17.2672 11.8331 16.888 12.0669 16.4495C12.4709 15.6921 12.8742 14.7563 13.1734 13.6554H16.7887C15.6958 15.6807 13.7234 17.1606 11.3839 17.5846ZM16.7887 6.34478H13.1734C12.8742 5.2439 12.4709 4.30808 12.0669 3.55066C11.8331 3.11214 11.5988 2.73299 11.3839 2.41558C13.7234 2.83957 15.6958 4.31944 16.7887 6.34478ZM1.6529 6.74242C2.95563 3.40663 6.20104 1.04175 10.0003 1.04175C13.7996 1.04175 17.045 3.40663 18.3477 6.74242C18.7424 7.7529 18.9587 8.85198 18.9587 10.0001C18.9587 11.1482 18.7424 12.2473 18.3477 13.2577C17.045 16.5935 13.7996 18.9584 10.0003 18.9584C6.20103 18.9584 2.95563 16.5935 1.6529 13.2577C1.25828 12.2473 1.04199 11.1482 1.04199 10.0001C1.04199 8.85198 1.25828 7.7529 1.6529 6.74242Z" fill="currentColor"/>
            </svg>
          </div>
          <span class="badge-label">Language</span>
          <span class="badge-value">{{ section.settings.language | default: 'EN' }}</span>
        </div>
      {% endif %}

      <!-- Publisher Badge -->
      {% if section.settings.publisher != blank %}
        <div class="badge-item">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.4668 2.20601C9.33822 1.42183 10.6607 1.42195 11.5322 2.20601L18.751 8.70308C19.0075 8.93393 19.0286 9.32834 18.7979 9.58492C18.5669 9.84149 18.1716 9.8627 17.915 9.63179L17.292 9.07027V17.083C17.292 17.6583 16.8253 18.125 16.25 18.125H3.75C3.17471 18.125 2.70801 17.6583 2.70801 17.083V9.07027L2.08496 9.63179C1.8284 9.86271 1.43307 9.84148 1.20215 9.58492C0.971426 9.32835 0.99253 8.93394 1.24903 8.70308L8.4668 2.20601ZM10.6963 3.13472C10.3001 2.77851 9.69876 2.77926 9.30274 3.1357L3.95801 7.94527V16.875H10.208V9.99996C10.208 9.65489 10.488 9.37513 10.833 9.37496H14.167C14.512 9.37513 14.792 9.65489 14.792 9.99996V16.875H16.042V7.94527L10.6963 3.13472ZM11.458 16.875H13.542V10.625H11.458V16.875ZM8.33301 9.37496C8.67819 9.37496 8.95801 9.65478 8.95801 9.99996V14.1669C8.95784 14.512 8.67808 14.7919 8.33301 14.7919H5.83301C5.48809 14.7918 5.20819 14.5119 5.20801 14.1669V9.99996C5.20801 9.65489 5.48798 9.37513 5.83301 9.37496H8.33301ZM6.45801 13.5419H7.70801V10.625H6.45801V13.5419Z" fill="currentColor"/>
            </svg>
          </div>
          <span class="badge-label">Publisher</span>
          <span class="badge-value">{{ section.settings.publisher | default: 'Name of Publisher' }}</span>
        </div>
      {% endif %}

      <!-- Date Published Badge - FIXED WITH PROPER CALENDAR ICON -->
      {% if section.settings.publish_date != blank %}
        <div class="badge-item">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15.833 2.5H15V1.66667C15 1.20643 14.6268 0.833333 14.1667 0.833333C13.7064 0.833333 13.3333 1.20643 13.3333 1.66667V2.5H6.66667V1.66667C6.66667 1.20643 6.29357 0.833333 5.83333 0.833333C5.3731 0.833333 5 1.20643 5 1.66667V2.5H4.16667C3.24619 2.5 2.5 3.24619 2.5 4.16667V16.6667C2.5 17.5871 3.24619 18.3333 4.16667 18.3333H15.833C16.7535 18.3333 17.5 17.5871 17.5 16.6667V4.16667C17.5 3.24619 16.7535 2.5 15.833 2.5ZM15.833 16.6667H4.16667V7.5H15.833V16.6667ZM4.16667 4.16667H15.833V5.83333H4.16667V4.16667Z" fill="currentColor"/>
              <path d="M6.66667 10H8.33333V11.6667H6.66667V10ZM10 10H11.6667V11.6667H10V10ZM13.3333 10H15V11.6667H13.3333V10Z" fill="currentColor"/>
            </svg>
          </div>
          <span class="badge-label">Date Published</span>
          <span class="badge-value">{{ section.settings.publish_date | default: 'July 10, 2025' }}</span>
        </div>
      {% endif %}

      <!-- Availability Badge -->
      {% if section.settings.availability_1 != blank or section.settings.availability_2 != blank %}
        <div class="badge-item availability-badge">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15.043 1.60848C16.6617 1.06897 18.3328 2.27336 18.333 3.97957V14.4971C18.333 15.6688 17.5196 16.6833 16.376 16.9376L10.1807 18.3145C10.0333 18.3473 9.87957 18.3388 9.73633 18.2911L3.37598 16.171C2.35532 15.8307 1.6671 14.8758 1.66699 13.7999V3.97957C1.66718 2.27336 3.33832 1.06897 4.95703 1.60848L10 3.28914L15.043 1.60848ZM16.667 13.5206C16.5728 13.5538 16.4755 13.5824 16.376 13.6046L10.833 14.836V16.462L16.0137 15.3106C16.395 15.2259 16.667 14.8877 16.667 14.4971V13.5206ZM3.33301 13.7999C3.33312 14.1585 3.56312 14.4765 3.90332 14.5899L9.16699 16.3448V14.7677L3.37598 12.838C3.36169 12.8332 3.34716 12.8283 3.33301 12.8233V13.7999ZM16.667 3.97957C16.6668 3.41092 16.1089 3.00969 15.5693 3.18953L10.833 4.76766V13.129L16.0137 11.9776C16.3949 11.8929 16.6669 11.5546 16.667 11.1641V3.97957ZM4.43066 3.18953C3.89115 3.00969 3.3332 3.41093 3.33301 3.97957V10.4659C3.33301 10.8246 3.56304 11.1435 3.90332 11.2569L9.16699 13.0108V4.76766L4.43066 3.18953ZM4.20996 8.9034C4.35553 8.46692 4.82715 8.23065 5.26367 8.37606L7.76367 9.21004C8.20023 9.35557 8.43646 9.82718 8.29102 10.2638C8.14548 10.7004 7.67295 10.9366 7.23633 10.7911L4.73633 9.95711C4.30001 9.81139 4.06447 9.33986 4.20996 8.9034ZM14.7363 8.37606C15.1729 8.23052 15.6455 8.46678 15.791 8.9034C15.9365 9.33999 15.7002 9.81155 15.2637 9.95711L12.7637 10.7911C12.3271 10.9365 11.8555 10.7003 11.71 10.2638C11.5644 9.82727 11.8 9.35575 12.2363 9.21004L14.7363 8.37606ZM4.20996 5.57039C4.35549 5.1338 4.82707 4.89756 5.26367 5.04305L7.76367 5.87606C8.20029 6.0216 8.43656 6.49412 8.29102 6.93074C8.14541 7.36726 7.67289 7.60263 7.23633 7.45711L4.73633 6.6241C4.3 6.47844 4.06457 6.00684 4.20996 5.57039ZM14.7363 5.04305C15.1729 4.89751 15.6455 5.13377 15.791 5.57039C15.9363 6.00692 15.7002 6.4786 15.2637 6.6241L12.7637 7.45711C12.3272 7.60261 11.8556 7.36716 11.71 6.93074C11.5644 6.4942 11.7999 6.02169 12.2363 5.87606L14.7363 5.04305Z" fill="currentColor"/>
            </svg>
          </div>
          <span class="badge-label">Availability</span>
          <div class="badge-values">
            {% if section.settings.availability_1 != blank %}
              <span class="badge-value">{{ section.settings.availability_1 | default: 'Hard Copy' }}</span>
            {% endif %}
            {% if section.settings.availability_1 != blank and section.settings.availability_2 != blank %}
              <span class="badge-separator">|</span>
            {% endif %}
            {% if section.settings.availability_2 != blank %}
              <span class="badge-value">{{ section.settings.availability_2 | default: 'Digital Copy' }}</span>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <!-- Sellers Badge -->
      {% if section.settings.seller_1 != blank or section.settings.seller_2 != blank %}
        <div class="badge-item sellers-badge">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M4.69935 0.833252C3.50764 0.833252 2.48161 1.6744 2.2479 2.84296L1.66634 5.75074V5.83325C1.66634 7.06706 2.33667 8.1443 3.33301 8.72064V16.6666H1.66634C1.2061 16.6666 0.833008 17.0397 0.833008 17.4999C0.833008 17.9602 1.2061 18.3333 1.66634 18.3333H18.333C18.7932 18.3333 19.1663 17.9602 19.1663 17.4999C19.1663 17.0397 18.7932 16.6666 18.333 16.6666H16.6663V8.72064C17.6627 8.1443 18.333 7.06706 18.333 5.83325V5.75074L17.7515 2.84296C17.5177 1.6744 16.4917 0.833252 15.3 0.833252H4.69935ZM3.8822 3.16982C3.9601 2.7803 4.30211 2.49992 4.69935 2.49992H6.66634V5.83325C6.66634 6.75373 5.92015 7.49992 4.99967 7.49992C4.10412 7.49992 3.37354 6.79358 3.33464 5.90762L3.8822 3.16982ZM11.6663 2.49992H8.33301V5.83325C8.33301 6.75373 9.0792 7.49992 9.99967 7.49992C10.9201 7.49992 11.6663 6.75373 11.6663 5.83325V2.49992ZM13.333 2.49992V5.83325C13.333 6.75373 14.0792 7.49992 14.9997 7.49992C15.8952 7.49992 16.6258 6.79358 16.6647 5.90762L16.1172 3.16982C16.0392 2.7803 15.6972 2.49992 15.3 2.49992H13.333ZM12.4997 8.0381C11.8889 8.73012 10.9953 9.16659 9.99967 9.16659C9.0041 9.16659 8.11046 8.73012 7.49967 8.0381C6.88889 8.73012 5.99525 9.16659 4.99967 9.16659V12.4999H14.9997V9.16659C14.0041 9.16659 13.1105 8.73012 12.4997 8.0381ZM14.9997 14.1666V16.6666H4.99967V14.1666H14.9997Z" fill="currentColor"/>
            </svg>
          </div>
          <span class="badge-label">Sellers</span>
          <div class="badge-values">
            {% if section.settings.seller_1 != blank %}
              <span class="badge-value">{{ section.settings.seller_1 | default: 'Official Site' }}</span>
            {% endif %}
            {% if section.settings.seller_1 != blank and section.settings.seller_2 != blank %}
              <span class="badge-separator">|</span>
            {% endif %}
            {% if section.settings.seller_2 != blank %}
              <span class="badge-value">{{ section.settings.seller_2 | default: 'Amazon' }}</span>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Add to Cart Section -->
    {% if section.settings.featured_product != blank %}
      {% assign product = all_products[section.settings.featured_product] %}
      {% if product %}
        <div class="product-form-wrapper">
          <form action="/cart/add" method="post" enctype="multipart/form-data" class="product-form" data-product-form>
            <!-- Product Info -->
            <div class="product-info">
              <h3 class="product-title">{{ product.title }}</h3>
              <div class="product-price">
                <span class="current-price" data-price>
                  {{- product.selected_or_first_available_variant.price | money -}}
                </span>
                {% if product.selected_or_first_available_variant.compare_at_price
                    > product.selected_or_first_available_variant.price
                %}
                  <span class="compare-price" data-compare-price>
                    {{- product.selected_or_first_available_variant.compare_at_price | money -}}
                  </span>
                {% endif %}
              </div>
            </div>

            <!-- Variant Selection -->
            {% if product.variants.size > 1 %}
              <div class="variant-selector">
                <label for="variant-select-{{ section.id }}">Format:</label>
                <select name="id" id="variant-select-{{ section.id }}" class="variant-select" data-variant-select>
                  {% for variant in product.variants %}
                    <option
                      value="{{ variant.id }}"
                      {% unless variant.available %}
                        disabled
                      {% endunless %}
                      data-price="{{ variant.price | money }}"
                      data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                      {% if variant == product.selected_or_first_available_variant %}
                        selected
                      {% endif %}
                    >
                      {{ variant.title }}
                      {% unless variant.available %} - Sold Out{% endunless %}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% else %}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {% endif %}

            <!-- Quantity -->
            <div class="quantity-container">
              <label for="quantity-{{ section.id }}">Quantity:</label>
              <div class="quantity-selector">
                <button type="button" class="quantity-btn minus" data-quantity-change="-1">-</button>
                <input
                  type="number"
                  name="quantity"
                  id="quantity-{{ section.id }}"
                  value="1"
                  min="1"
                  class="quantity-input"
                  data-quantity-input
                >
                <button type="button" class="quantity-btn plus" data-quantity-change="1">+</button>
              </div>
            </div>

            <!-- Add to Cart Button -->
            <button
              type="submit"
              class="add-to-cart-btn"
              data-add-to-cart
              {% unless product.selected_or_first_available_variant.available %}
                disabled
              {% endunless %}
            >
              <svg class="cart-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path d="M4.167 1.667c.321 0 .614.184.752.474l1.191 2.5c.03.063.052.13.065.198L7.334 10.74l7.66-.96c.345-.045.626-.3.704-.639l.99-4.289c.104-.448-.175-.895-.623-.792-.448.104-.727.551-.623 1l-.99 4.289-7.66.96c-.04.005-.08.007-.12 0H5.833c-.46 0-.833.373-.833.833 0 .46.373.834.833.834H15.833c1.381 0 2.5 1.119 2.5 2.5 0 1.38-1.119 2.5-2.5 2.5-1.38 0-2.5-1.12-2.5-2.5 0-.292.05-.573.142-.834H9.024c.092.261.142.542.142.834 0 1.38-1.119 2.5-2.5 2.5-1.38 0-2.5-1.12-2.5-2.5 0-.445.116-.864.32-1.226-.694-.444-1.154-1.222-1.154-2.107 0-1.321 1.025-2.402 2.322-2.493L4.56 5.264 3.641 3.333H1.667c-.46 0-.834-.327-.834-.787 0-.46.374-.833.834-.833H4.167z"/>
              </svg>
              <span class="button-text">Add to Cart</span>
            </button>
          </form>
        </div>
      {% endif %}
    {% endif %}

    <!-- Purchase Buttons - ENHANCED URL HANDLING -->
    <div class="purchase-buttons">
      {% comment %} PRIMARY BUTTON HIDDEN - Removed the primary button display {% endcomment %}

      {% if section.settings.secondary_btn_text %}
        {% comment %} Enhanced URL handling for external links {% endcomment %}
        {% assign button_url = section.settings.secondary_btn_url | default: '#' %}
        {% if section.settings.amazon_url != blank %}
          {% assign button_url = section.settings.amazon_url %}
        {% endif %}
        
        <a 
          href="{{ button_url }}" 
          class="purchase-btn secondary-btn"
          {% if button_url contains 'amazon' or button_url contains 'amzn' %}
            target="_blank" 
            rel="noopener noreferrer"
          {% endif %}
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
