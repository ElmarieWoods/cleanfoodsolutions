<div class="member-hub-recipes" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="recipes-header">
      <h2 class="recipes-title">{{ section.settings.title | default: 'Exclusive Recipes' }}</h2>
      <p class="recipes-subtitle">
        {{ section.settings.subtitle | default: 'Exclusive recipes curated for our community members' }}
      </p>
    </div>
    <!-- Recipe Categories Filter -->
    <div class="recipe-categories">
      <button class="category-btn active" data-category="all">All Recipes</button>
      {% for block in section.blocks %}
        {% if block.type == 'recipe_category' %}
          <button class="category-btn" data-category="{{ block.settings.category_slug }}">
            {{ block.settings.category_name }}
          </button>
        {% endif %}
      {% endfor %}
    </div>
    <!-- Recipes Grid -->
    <div class="recipes-grid" id="recipes-container">
      {%- assign recipes_found = false -%}
      {% for block in section.blocks %}
        {% if block.type == 'recipe' %}
          {%- assign recipes_found = true -%}
          <div class="recipe-card" data-category="{{ block.settings.category }}" data-block-id="{{ block.id }}">
            <div class="recipe-image">
              {% if block.settings.recipe_image %}
                <img
                  src="{{ block.settings.recipe_image | image_url: width: 400 }}"
                  alt="{{ block.settings.recipe_title }}"
                  loading="lazy"
                >
              {% else %}
                <div class="recipe-placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 12C8 8.68629 10.6863 6 14 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M12 8C12 10.2091 10.2091 12 8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M16 12C16 14.2091 14.2091 16 12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M12 16C12 13.7909 13.7909 12 16 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M8 12C8 14.2091 9.79086 16 12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M12 8C9.79086 8 8 9.79086 8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M16 12C16 9.79086 14.2091 8 12 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M12 16C14.2091 16 16 14.2091 16 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>
              {% endif %}
              <div class="recipe-overlay">
                <span class="recipe-time">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12,6 12,12 16,14"/>
                  </svg>
                  {{ block.settings.prep_time | default: '30' }} min
                </span>
                <span class="recipe-difficulty">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M3 12H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M7.5 7.5L16.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M16.5 7.5L7.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M6 6L8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M16 16L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M6 18L8 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M16 8L18 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  {{ block.settings.difficulty | default: 'Easy' }}
                </span>
              </div>
            </div>
            <div class="recipe-content">
              <h3 class="recipe-title">{{ block.settings.recipe_title }}</h3>
              <p class="recipe-description">{{ block.settings.recipe_description | truncate: 120 }}</p>
              <div class="recipe-meta">
                <span class="recipe-servings">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                  {{ block.settings.servings | default: '4' }} servings
                </span>
                <span class="recipe-category-tag">{{ block.settings.category | capitalize }}</span>
              </div>
              <button class="recipe-view-btn" onclick="openRecipeModal('{{ block.id }}')">View Recipe</button>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <!-- Empty State -->
    {% if recipes_found == false %}
      <div class="empty-state">
        <div class="empty-state-icon">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
            <path d="M8 12C8 8.68629 10.6863 6 14 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M12 8C12 10.2091 10.2091 12 8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M16 12C16 14.2091 14.2091 16 12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M12 16C12 13.7909 13.7909 12 16 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M8 12C8 14.2091 9.79086 16 12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M12 8C9.79086 8 8 9.79086 8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M16 12C16 9.79086 14.2091 8 12 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M12 16C14.2091 16 16 14.2091 16 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <h3>No Recipes Yet</h3>
        <p>Check back soon for delicious member-exclusive recipes!</p>
      </div>
    {% endif %}
  </div>
</div>
<!-- Recipe Modal -->
<div id="recipe-modal" class="recipe-modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modal-recipe-title"></h2>
      <button class="modal-close" onclick="closeRecipeModal()">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="modal-image">
        <img id="modal-recipe-image" src="/placeholder.svg" alt="">
      </div>
      <div class="modal-details">
        <div class="recipe-info">
          <span id="modal-prep-time">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12,6 12,12 16,14"/>
            </svg>
          </span>
          <span id="modal-servings">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </span>
          <span id="modal-difficulty">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 3V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M3 12H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M7.5 7.5L16.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M16.5 7.5L7.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </span>
        </div>
        <p id="modal-description"></p>
        <div class="recipe-sections">
          <div class="ingredients-section">
            <h3>Ingredients</h3>
            <ul id="modal-ingredients"></ul>
          </div>
          <div class="instructions-section">
            <h3>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                <path d="M8 12C8 8.68629 10.6863 6 14 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 8C12 10.2091 10.2091 12 8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M16 12C16 14.2091 14.2091 16 12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 16C12 13.7909 13.7909 12 16 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M8 12C8 14.2091 9.79086 16 12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 8C9.79086 8 8 9.79086 8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M16 12C16 9.79086 14.2091 8 12 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 16C14.2091 16 16 14.2091 16 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              Instructions
            </h3>
            <ol id="modal-instructions"></ol>
          </div>
        </div>
        <!-- Where to Get It Section -->
        <div class="where-to-get-section">
          <h3>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            Where to Get It
          </h3>
          <div class="brand-showcase" id="modal-brand-showcase">
            <div class="brand-image-container">
              <img id="modal-brand-image" src="/placeholder.svg?height=200&width=300" alt="Brand showcase">
              <div class="brand-overlay">
                <div class="brand-subtitle">Available at</div>
                <div class="brand-info">
                  <div class="brand-name-container">
                    <span id="modal-brand-name">Brand Name</span>
                  </div>
                </div>
              </div>
            </div>
            <a href="#" id="modal-brand-link" class="brand-visit-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15,3 21,3 21,9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              Visit Brand Page
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  /* ==========================================================================
     MEMBER HUB RECIPES - DESIGN SYSTEM WITH ORIGINAL FUNCTIONALITY
     ========================================================================== */
  .member-hub-recipes {
    padding: 32px 0;
    background: #FFFFFF;
    min-height: fit-content;
  }
  .container {
    max-width: 1152px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .recipes-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .recipes-title {
    font-family: 'Mitogen Display';
    font-style: normal;
    font-weight: 400;
    font-size: clamp(28px, 5vw, 36px);
    line-height: 1.25;
    color: #1F2937;
    margin-bottom: 20px;
  }
  .recipes-subtitle {
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 400;
    font-size: clamp(16px, 3vw, 20px);
    line-height: 1.4;
    color: #1F2937;
    max-width: 600px;
    margin: 0 auto;
  }
  .recipe-categories {
    display: flex;
    gap: 20px;
    margin-bottom: 32px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: thin;
    justify-content: center;
  }
  .category-btn {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 12px 35px;
    gap: 10px;
    background: #1F2937;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    flex-shrink: 0;
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 400;
    font-size: 20px;
    line-height: 28px;
    color: #FFFFFF;
  }
  .category-btn:hover,
  .category-btn.active {
    background: #EC4899;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.3);
  }
  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(350px, 100%), 1fr));
    gap: 32px;
    margin-bottom: 32px;
  }
  .recipe-card {
    background: #FFFFFF;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    height: fit-content;
    border: 5px solid #E3F4F4;
  }
  .recipe-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    border-color: #EC4899;
  }
  .recipe-image {
    position: relative;
    height: clamp(200px, 25vw, 250px);
    overflow: hidden;
  }
  .recipe-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .recipe-card:hover .recipe-image img {
    transform: scale(1.05);
  }
  .recipe-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #E3F4F4 0%, #f0f9f9 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1F2937;
  }
  .recipe-overlay {
    position: absolute;
    top: 200px; /* Changed from 60px to 100px for additional 40px clearance */
    right: 20px;
    display: flex;
    gap: 15px;
    flex-direction: column;
    z-index: 2; /* Added z-index to ensure it's above other elements */
  }
  .recipe-time,
  .recipe-difficulty {
    background: rgba(31, 41, 55, 0.95); /* Increased opacity for better visibility */
    color: #FFFFFF;
    padding: 10px 14px; /* Increased padding for better touch targets */
    border-radius: 12px; /* Slightly larger border radius */
    font-family: 'Serotiva';
    font-size: 13px; /* Slightly larger font */
    font-weight: 500; /* Increased font weight */
    display: flex;
    align-items: center;
    gap: 6px;
    backdrop-filter: blur(8px); /* Increased blur for better separation */
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15); /* Added shadow for depth */
    border: 1px solid rgba(255, 255, 255, 0.1); /* Subtle border */
  }
  .recipe-content {
    padding: 20px;
  }
  .recipe-title {
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 700;
    font-size: clamp(18px, 3vw, 20px);
    line-height: 1.4;
    color: #1F2937;
    margin-bottom: 10px;
  }
  .recipe-description {
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.6;
    color: #1F2937;
    margin-bottom: 20px;
  }
  .recipe-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 10px;
  }
  .recipe-servings {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #1F2937;
    font-family: 'Serotiva';
    font-size: 14px;
    font-weight: 400;
  }
  .recipe-category-tag {
    background: #E3F4F4;
    color: #1F2937;
    padding: 6px 12px;
    border-radius: 10px;
    font-family: 'Serotiva';
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .recipe-view-btn {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 12px 35px;
    gap: 10px;
    background: #1F2937;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 400;
    font-size: 20px;
    line-height: 28px;
    color: #FFFFFF;
  }
  .recipe-view-btn:hover {
    background: #EC4899;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.4);
  }
  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #FFFFFF;
    border-radius: 20px;
    border: 5px solid #E3F4F4;
  }
  .empty-state-icon {
    color: #1F2937;
    margin-bottom: 20px;
  }
  .empty-state h3 {
    font-family: 'Mitogen Display';
    font-style: normal;
    font-weight: 400;
    font-size: clamp(24px, 4vw, 36px);
    line-height: 1.25;
    color: #1F2937;
    margin-bottom: 20px;
  }
  .empty-state p {
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 400;
    font-size: clamp(16px, 2.5vw, 20px);
    line-height: 1.4;
    color: #1F2937;
  }
  /* Recipe Modal */
  .recipe-modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 60px;
    width: 100%;
    height: 100%;
    background-color: rgba(31, 41, 55, 0.8);
    backdrop-filter: blur(4px);
  }
  .modal-content {
    background-color: #FFFFFF;
    margin: 2% auto;
    padding: 0;
    border-radius: 20px;
    width: min(90%, 900px);
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    border: 5px solid #E3F4F4;
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 5px solid #E3F4F4;
    position: sticky;
    top: 0;
    background: #FFFFFF;
    z-index: 10;
    border-radius: 20px 20px 0 0;
  }
  .modal-header h2 {
    font-family: 'Mitogen Display';
    font-style: normal;
    font-weight: 400;
    font-size: clamp(24px, 4vw, 36px);
    line-height: 1.25;
    color: #1F2937;
    margin: 0;
  }
  .modal-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    border-radius: 10px;
    transition: all 0.3s ease;
    color: #1F2937;
  }
  .modal-close:hover {
    background: #E3F4F4;
    transform: scale(1.1);
  }
  .modal-body {
    padding: 20px;
  }
  .modal-image img {
    width: 100%;
    height: clamp(250px, 35vw, 350px);
    object-fit: cover;
    border-radius: 20px;
    margin-bottom: 20px;
  }
  .recipe-info {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .recipe-info span {
    background: #E3F4F4;
    padding: 10px 20px;
    border-radius: 10px;
    font-family: 'Serotiva';
    font-size: 14px;
    font-weight: 400;
    color: #1F2937;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .modal-details p {
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 400;
    font-size: clamp(14px, 2.5vw, 16px);
    line-height: 1.6;
    color: #1F2937;
    margin-bottom: 32px;
  }
  .recipe-sections {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 32px;
  }
  .ingredients-section h3,
  .instructions-section h3,
  .where-to-get-section h3 {
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 700;
    font-size: 20px;
    line-height: 28px;
    color: #1F2937;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ingredients-section h3 svg,
  .instructions-section h3 svg,
  .where-to-get-section h3 svg {
    color: #EC4899;
  }
  .ingredients-section ul,
  .instructions-section ol {
    padding-left: 20px;
  }
  .ingredients-section li,
  .instructions-section li {
    margin-bottom: 10px;
    font-family: 'Serotiva';
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.6;
    color: #1F2937;
  }
  .instructions-section li {
    padding-left: 10px;
  }
  /* Where to Get It Section */
  .where-to-get-section {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 5px solid #E3F4F4;
  }
  .brand-showcase {
    background: #FFFFFF;
    border-radius: 20px;
    overflow: hidden;
    border: 5px solid #E3F4F4;
    transition: all 0.3s ease;
  }
  .brand-showcase:hover {
    border-color: #EC4899;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(236, 72, 153, 0.15);
  }
  .brand-image-container {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  .brand-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .brand-showcase:hover .brand-image-container img {
    transform: scale(1.05);
  }
  .brand-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(31, 41, 55, 0.9));
    padding: 20px;
    color: #FFFFFF;
  }
  .brand-subtitle {
    font-family: 'Serotiva';
    font-size: 14px;
    font-weight: 400;
    opacity: 0.8;
    margin-bottom: 8px;
  }
  .brand-name-container {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 10px;
    padding: 10px 15px;
    display: inline-block;
  }
  .brand-name-container span {
    font-family: 'Serotiva';
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
  }
  .brand-visit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 15px;
    background: #1F2937;
    color: #FFFFFF;
    text-decoration: none;
    font-family: 'Serotiva';
    font-size: 16px;
    font-weight: 400;
    transition: all 0.3s ease;
  }
  .brand-visit-btn:hover {
    background: #EC4899;
    color: #FFFFFF;
  }
  /* Hidden class for filtering */
  .recipe-card.hidden {
    display: none;
  }
  /* Smooth animations */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .recipe-card {
    animation: fadeIn 0.5s ease-out;
  }
  /* Custom scrollbar */
  .recipe-categories::-webkit-scrollbar {
    height: 4px;
  }
  .recipe-categories::-webkit-scrollbar-track {
    background: #E3F4F4;
    border-radius: 2px;
  }
  .recipe-categories::-webkit-scrollbar-thumb {
    background: #EC4899;
    border-radius: 2px;
  }
  .recipe-categories::-webkit-scrollbar-thumb:hover {
    background: #1F2937;
  }
  /* Mobile Responsive */
  @media (max-width: 768px) {
    .recipe-categories {
      justify-content: flex-start;
      padding-right: 20px;
    }
    .recipes-grid {
      grid-template-columns: 1fr;
    }
    .recipe-sections {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .modal-content {
      margin: 5% auto;
      width: 95%;
      max-height: 85vh;
    }
    .modal-body {
      padding: 15px;
    }
    .modal-header {
      padding: 15px;
    }
    .recipe-overlay {
      flex-direction: row;
      top: 70px; /* Adjusted from 30px to 70px for mobile */
      right: 15px;
      gap: 10px;
    }
    .recipe-time,
    .recipe-difficulty {
      font-size: 11px;
      padding: 8px 10px;
    }
  }
  @media (max-width: 480px) {
    .container {
      padding: 0 15px;
    }
    .category-btn {
      padding: 10px 20px;
      font-size: 16px;
    }
    .recipe-content {
      padding: 15px;
    }
    .recipe-overlay {
      top: 60px; /* Adjusted from 20px to 60px for very small screens */
    }
  }
</style>
<script>
  // Recipe filtering functionality
  document.addEventListener('DOMContentLoaded', function() {
    const categoryBtns = document.querySelectorAll('.category-btn');
    const recipeCards = document.querySelectorAll('.recipe-card');
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const category = this.dataset.category;
        // Update active button
        categoryBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        // Filter recipes with animation
        recipeCards.forEach(card => {
          if (category === 'all' || card.dataset.category === category) {
            card.classList.remove('hidden');
            card.style.animation = 'fadeIn 0.5s ease-out';
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
  // Recipe modal functionality
  const recipeData = {
    {% for block in section.blocks %}
      {% if block.type == 'recipe' %}
      '{{ block.id }}': {
        title: {{ block.settings.recipe_title | json }},
        image: {% if block.settings.recipe_image %}{{ block.settings.recipe_image | image_url: width: 600 | json }}{% else %}"/placeholder.svg?height=300&width=600"{% endif %},
        description: {{ block.settings.recipe_description | json }},
        prepTime: {{ block.settings.prep_time | default: 30 | json }},
        servings: {{ block.settings.servings | default: 4 | json }},
        difficulty: {{ block.settings.difficulty | default: 'Easy' | json }},
        ingredients: {{ block.settings.ingredients | split: '
' | json }},
        instructions: {{ block.settings.instructions | split: '
' | json }},
        brandName: {{ block.settings.brand_name | default: 'Local Store' | json }},
        brandUrl: {{ block.settings.brand_url | default: '#' | json }},
        brandImage: {% if block.settings.brand_image %}{{ block.settings.brand_image | image_url: width: 300 | json }}{% else %}"/placeholder.svg?height=200&width=300&text=Brand+Showcase"{% endif %}
      }{% unless forloop.last %},{% endunless %}
      {% endif %}
    {% endfor %}
  };

  function openRecipeModal(recipeId) {
    const recipe = recipeData[recipeId];
    if (!recipe) return;
    const modal = document.getElementById('recipe-modal');
    // Populate modal content
    document.getElementById('modal-recipe-title').textContent = recipe.title;
    document.getElementById('modal-recipe-image').src = recipe.image;
    document.getElementById('modal-recipe-image').alt = recipe.title;
    document.getElementById('modal-description').textContent = recipe.description;
    document.getElementById('modal-prep-time').innerHTML = `
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="10"/>
    <polyline points="12,6 12,12 16,14"/>
  </svg>
  ${recipe.prepTime} min
`;
    document.getElementById('modal-servings').innerHTML = `
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
    <circle cx="9" cy="7" r="4"/>
    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
  </svg>
  ${recipe.servings} servings
`;
    document.getElementById('modal-difficulty').innerHTML = `
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 3V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M3 12H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M7.5 7.5L16.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M16.5 7.5L7.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
  </svg>
  ${recipe.difficulty}
`;
    // Populate ingredients
    const ingredientsList = document.getElementById('modal-ingredients');
    ingredientsList.innerHTML = '';
    recipe.ingredients.forEach(ingredient => {
      if (ingredient.trim()) {
        const li = document.createElement('li');
        li.textContent = ingredient.trim();
        ingredientsList.appendChild(li);
      }
    });
    // Populate instructions
    const instructionsList = document.getElementById('modal-instructions');
    instructionsList.innerHTML = '';
    recipe.instructions.forEach(instruction => {
      if (instruction.trim()) {
        const li = document.createElement('li');
        li.textContent = instruction.trim();
        instructionsList.appendChild(li);
      }
    });
    // Populate brand information
    document.getElementById('modal-brand-name').textContent = recipe.brandName;
    document.getElementById('modal-brand-image').src = recipe.brandImage;
    document.getElementById('modal-brand-image').alt = recipe.brandName + ' showcase';
    document.getElementById('modal-brand-link').href = recipe.brandUrl;
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
    // Add fade-in animation
    modal.style.opacity = '0';
    setTimeout(() => {
      modal.style.opacity = '1';
      modal.style.transition = 'opacity 0.3s ease';
    }, 10);
  }

  function closeRecipeModal() {
    const modal = document.getElementById('recipe-modal');
    modal.style.opacity = '0';
    setTimeout(() => {
      modal.style.display = 'none';
      document.body.style.overflow = 'auto';
    }, 300);
  }
  // Close modal when clicking outside
  window.onclick = function(event) {
    const modal = document.getElementById('recipe-modal');
    if (event.target == modal) {
      closeRecipeModal();
    }
  }
  // Close modal with Escape key
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeRecipeModal();
    }
  });
  // Add smooth scroll behavior for category buttons
  document.querySelectorAll('.category-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      // Smooth scroll the button into view if needed
      this.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'center'
      });
    });
  });
</script>

