{%- comment -%}
  Your Benefits Section - Stackable Responsive Grid
  Features: Dynamic benefit cards with icons, titles, descriptions, and action buttons
{%- endcomment -%}

<style>
  .benefits-section {
    /* Full viewport coverage */
    width: 100vw;
    margin: 0;
    padding: clamp(40px, 8vh, 100px) 0;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background: {{ section.settings.background_color | default: '#f9fafb' }};
    box-sizing: border-box;
  }

  .benefits-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 60px);
  }

  .benefits-header {
    text-align: center;
    margin-bottom: clamp(32px, 6vw, 60px);
  }

  .benefits-title {
    font-family: 'Mitogen Display', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 600;
    color: {{ section.settings.title_color | default: '#000000' }};
    margin-bottom: clamp(8px, 2vw, 16px);
    line-height: 1.2;
    /* Mobile-first responsive text sizing */
    font-size: 24px;
  }

  .benefits-subtitle {
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    color: {{ section.settings.subtitle_color | default: '#374151' }};
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
    /* Mobile-first responsive text sizing */
    font-size: 14px;
  }

  .benefits-grid {
    display: grid;
    gap: clamp(20px, 3vw, 28px);
    max-width: 1200px;
    margin: 0 auto;
    justify-items: center;
    /* Mobile: 1 column */
    grid-template-columns: 1fr;
  }

  .benefit-card {
    background: #ffffff;
    border-radius: 12px;
    padding: clamp(20px, 4vw, 28px);
    box-shadow: 0 0 4px 0 #ec4899;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap; /* allows children to wrap if needed */
    gap: clamp(12px, 2.5vw, 18px);
    width: 100%;
    max-width: 100%;
    position: relative;
    overflow: visible; /* let content overflow naturally if needed */
    height: auto; /* ensure flexible height */
  }

  .benefit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0px 4px 20px 0px rgba(236, 72, 153, 0.3);
  }

  .benefit-icon {
    width: 32px;
    height: 32px;
    margin: 0 auto;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .benefit-icon svg {
    width: 100%;
    height: 100%;
    fill: #000000;
  }

  .benefit-content {
    text-align: center;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1.5vw, 10px);
  }

  .benefit-title {
    font-family: 'Mitogen Display', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 400;
    color: #000000;
    line-height: 1.3;
    margin: 0;
    /* Mobile-first responsive text sizing */
    font-size: 16px;
  }

  .benefit-description {
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #000000;
    line-height: 1.4;
    margin: 0;
    flex: 1;
    display: block;
    /* Mobile-first responsive text sizing */
    font-size: 11px;
  }

  /* Tablet Styles - 481px to 1024px */
  @media (min-width: 481px) {
    .benefits-title {
      font-size: 32px;
    }

    .benefits-subtitle {
      font-size: 16px;
    }

    .benefit-title {
      font-size: 18px;
    }

    .benefit-description {
      font-size: 12px;
    }

    .benefit-btn {
      font-size: 12px;
      min-height: 42px;
    }

    .benefit-buttons {
      /* Side by side buttons on tablet+ */
      flex-direction: row;
    }

    .benefit-icon {
      width: 34px;
      height: 34px;
    }
  }

  /* Small Tablet - 2 columns */
  @media (min-width: 600px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Large Tablet Styles - 769px to 1024px */
  @media (min-width: 769px) {
    .benefits-title {
      font-size: 36px;
    }

    .benefits-subtitle {
      font-size: 17px;
    }

    .benefit-title {
      font-size: 19px;
    }

    .benefit-description {
      font-size: 12px;
    }

    .benefit-btn {
      font-size: 13px;
      min-height: 44px;
    }

    .benefit-icon {
      width: 35px;
      height: 35px;
    }
  }

  /* Desktop Styles - 1025px and up */
  @media (min-width: 1025px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .benefits-title {
      font-size: 42px;
    }

    .benefits-subtitle {
      font-size: 18px;
    }

    .benefit-title {
      font-size: 20px;
    }

    .benefit-description {
      font-size: 13px;
    }

    .benefit-icon {
      width: 36px;
      height: 36px;
    }
  }

  /* Large Desktop Styles - 1440px and up */
  @media (min-width: 1440px) {
    .benefits-title {
      font-size: 48px;
    }

    .benefits-subtitle {
      font-size: 19px;
    }

    .benefit-title {
      font-size: 22px;
    }

    .benefit-description {
      font-size: 14px;
    }

    .benefit-icon {
      width: 38px;
      height: 38px;
    }
  }

  /* Extra Large Desktop - 1920px and up */
  @media (min-width: 1920px) {
    .benefits-title {
      font-size: 52px;
    }

    .benefits-subtitle {
      font-size: 20px;
    }

    .benefit-title {
      font-size: 24px;
    }

    .benefit-description {
      font-size: 15px;
    }

    .benefit-icon {
      width: 40px;
      height: 40px;
    }
  }

  /* Accessibility */
  .benefit-btn:focus {
    outline: 3px solid rgba(59, 130, 246, 0.5);
    outline-offset: 2px;
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .benefit-card,
    .benefit-btn {
      transition: none;
    }
    .benefit-card:hover,
    .benefit-btn:hover {
      transform: none;
    }
  }

  /* Print Styles */
  @media print {
    .benefit-card {
      box-shadow: none;
      border: 1px solid #ccc;
      page-break-inside: avoid;
      margin-bottom: 20px;
    }
  }

  /* High DPI Displays */
  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    .benefit-card {
      box-shadow: 0px 0px 2px 0px #ec4899;
    }
  }
</style>

