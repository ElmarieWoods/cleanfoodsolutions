{% comment %}  Why It Matters Section - Clean Food Solutions  Features: Fully responsive 2-column layout with image filling container, call-to-action, responsive design with full background coverage{% endcomment %}

<section class="why-it-matters-section" data-section-id="{{ section.id }}">
  <div class="why-it-matters-container">
    <!-- Header Section -->
    <div class="section-header">
      <h2 class="section-title">
        {{ section.settings.title | default: 'Why It Matters' }}
      </h2>
    </div>

    <!-- Main Content Area: 2-Column Grid Layout -->
    <div class="content-area">
      <!-- LEFT COLUMN: Image Container -->
      <div class="image-container">
        {% if section.settings.featured_image %}
          <img
            src="{{ section.settings.featured_image | img_url: '1200x800' }}"
            alt="{{ section.settings.image_alt | default: 'Why it matters illustration' }}"
            class="featured-image"
            loading="lazy"
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 600px"
            srcset="
              {{ section.settings.featured_image | img_url: '400x300' }} 400w,
              {{ section.settings.featured_image | img_url: '600x450' }} 600w,
              {{ section.settings.featured_image | img_url: '800x600' }} 800w,
              {{ section.settings.featured_image | img_url: '1200x800' }} 1200w
            "
          >
        {% else %}
          <div class="image-placeholder">
            <svg width="200" height="150" viewBox="0 0 200 150" fill="none">
              <rect width="200" height="150" rx="8" fill="#f3f4f6"/>
              <path d="M50 112.5L87.5 75L125 112.5M150 37.5V112.5C150 116.642 146.642 120 142.5 120H57.5C53.358 120 50 116.642 50 112.5V37.5C50 33.358 53.358 30 57.5 30H142.5C146.642 30 150 33.358 150 37.5Z" stroke="#9ca3af" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="75" cy="56.25" r="7.5" stroke="#9ca3af" stroke-width="3"/>
            </svg>
            <p>Add featured image</p>
          </div>
        {% endif %}
      </div>

      <!-- RIGHT COLUMN: Text Content Container -->
      <div class="text-content-container">
        <!-- Main Message -->
        <div class="main-message">
          <p>
            {{
              section.settings.main_message
              | default: "Together, we're making mycotoxin-free as common as gluten-free. By joining you are protecting kids from the inside out."
            }}
          </p>
        </div>

        <!-- Pink Divider -->
        <div class="divider"></div>

        <!-- Call to Action Content -->
        <div class="cta-content">
          <p class="cta-heading">
            {{ section.settings.cta_heading | default: 'Ready to stay a step ahead?' }}
          </p>
          <p class="cta-description">
            {{
              section.settings.cta_description
              | default: 'Join hundreds of families getting trusted research, recipes, and peace of mind.'
            }}
          </p>
        </div>

        <!-- CTA Button - Updated to link to subscription section -->
        <div class="cta-button-container">
          <a href="#subscription-product" class="cta-button" data-smooth-scroll>
            {{ section.settings.button_text | default: 'Get Started' }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Full viewport coverage */
  .why-it-matters-section {
    width: 100vw;
    margin: 0;
    padding: 0;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
    box-sizing: border-box;
    overflow: hidden;
  }

  .why-it-matters-container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(40px, 8vh, 40px) clamp(20px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vh, 40px);
    box-sizing: border-box;
    justify-content: center;
  }

  /* Header Styles - Fully Responsive */
  .section-header {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  .section-title {
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(24px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.2;
    color: {{ section.settings.title_color | default: '#374151' }};
    margin: 0;
    padding: 0;
    word-wrap: break-word;
    hyphens: auto;
  }

  /* Content Area - Fully Responsive 2-column grid */
  .content-area {
    display: flex;
    gap: clamp(20px, 4vw, 60px);
    align-items: stretch;
    width: 100%;
    height: auto;
    min-height: clamp(400px, 50vh, 600px);
    margin: 0;
    padding: 0;
  }

  /* Extra Large Desktop (1440px+) */
  @media (min-width: 1440px) {
    .content-area {
      gap: clamp(60px, 5vw, 80px);
      min-height: 600px;
    }
  }

  /* Large Desktop (1200px - 1439px) */
  @media (min-width: 1200px) and (max-width: 1439px) {
    .content-area {
      gap: clamp(50px, 4vw, 60px);
      min-height: 550px;
    }
  }

  /* Desktop (1025px - 1199px) */
  @media (min-width: 1025px) and (max-width: 1199px) {
    .content-area {
      flex-direction: row;
      gap: clamp(40px, 4vw, 50px);
      min-height: 500px;
    }
    .image-container {
      flex: 1;
      height: 100%;
      order: 1;
    }
    .text-content-container {
      flex: 1;
      height: 100%;
      justify-content: center;
      order: 2;
    }
  }

  /* Large Desktop and above: 2-column grid - Image LEFT, Text RIGHT */
  @media (min-width: 1025px) {
    .content-area {
      flex-direction: row;
      min-height: clamp(500px, 40vh, 600px);
    }
    .image-container {
      flex: 1;
      height: 100%;
      order: 1;
      min-height: clamp(400px, 40vh, 600px);
    }
    .text-content-container {
      flex: 1;
      height: 100%;
      justify-content: center;
      order: 2;
      padding: clamp(20px, 3vw, 40px);
    }
  }

  /* Tablet Landscape (769px - 1024px) */
  @media (min-width: 769px) and (max-width: 1024px) {
    .why-it-matters-container {
      padding: clamp(32px, 6vh, 60px) clamp(16px, 3vw, 40px);
    }
    .content-area {
      flex-direction: row;
      gap: clamp(24px, 3vw, 40px);
      min-height: clamp(350px, 45vh, 450px);
    }
    .image-container {
      flex: 1;
      height: 100%;
      order: 1;
      min-height: clamp(300px, 35vh, 400px);
    }
    .text-content-container {
      flex: 1;
      order: 2;
      padding: clamp(16px, 2vw, 24px);
    }
  }

  /* Tablet Portrait (481px - 768px) */
  @media (min-width: 481px) and (max-width: 768px) {
    .why-it-matters-section {
      min-height: auto;
    }
    .why-it-matters-container {
      min-height: auto;
      justify-content: flex-start;
      padding: clamp(24px, 5vh, 48px) clamp(16px, 4vw, 32px);
      gap: clamp(24px, 5vh, 40px);
    }
    .content-area {
      flex-direction: column;
      gap: clamp(20px, 4vw, 32px);
      min-height: auto;
    }
    .image-container {
      width: 100%;
      height: clamp(250px, 35vw, 350px);
      order: 1;
    }
    .text-content-container {
      width: 100%;
      order: 2;
      padding: 0;
    }
  }

  /* Mobile (320px - 480px) */
  @media (max-width: 480px) {
    .why-it-matters-section {
      min-height: auto;
    }
    .why-it-matters-container {
      min-height: auto;
      justify-content: center;
      padding: clamp(20px, 4vh, 32px) clamp(12px, 3vw, 20px);
      gap: clamp(20px, 4vh, 32px);
    }
    .content-area {
      flex-direction: column;
      gap: clamp(16px, 3vw, 24px);
      min-height: auto;
    }
    .image-container {
      width: 100%;
      height: clamp(200px, 40vw, 280px);
      order: 1;
    }
    .text-content-container {
      width: 100%;
      order: 2;
      padding: 0;
    }
  }

  /* Image Container - Always fills container completely */
  .image-container {
    position: relative;
    overflow: hidden;
    border-radius: clamp(8px, 1vw, 12px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f9fafb;
    width: 100%;
    height: 100%;
  }

  /* Featured Image - Always fills container */
  .featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: inherit;
    transition: transform 0.3s ease;
  }

  .featured-image:hover {
    transform: scale(1.02);
  }

  /* Image Placeholder - Responsive */
  .image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 16px);
    color: #6b7280;
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(14px, 2vw, 16px);
    width: 100%;
    height: 100%;
    min-height: clamp(150px, 20vh, 200px);
    text-align: center;
    padding: clamp(16px, 3vw, 24px);
    box-sizing: border-box;
  }

  .image-placeholder svg {
    width: clamp(120px, 15vw, 200px);
    height: clamp(90px, 11.25vw, 150px);
    flex-shrink: 0;
  }

  /* Text Content Container - Fully Responsive */
  .text-content-container {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 3vw, 32px);
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  /* Main Message - Responsive Typography */
  .main-message {
    width: 100%;
  }

  .main-message p {
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(20px, 3.5vw, 40px);
    font-weight: 400;
    line-height: clamp(1.2, 1.3, 1.4);
    color: {{ section.settings.main_text_color | default: '#374151' }};
    margin: 0;
    padding: 0;
    word-wrap: break-word;
    hyphens: auto;
  }

  /* Pink Divider - Responsive */
  .divider {
    width: 100%;
    height: clamp(1px, 0.2vw, 2px);
    background-color: {{ section.settings.divider_color | default: '#ec4899' }};
    margin: 0;
    padding: 0;
    border-radius: 1px;
  }

  /* CTA Content - Responsive */
  .cta-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1.5vw, 12px);
  }

  .cta-heading {
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 700;
    line-height: clamp(1.2, 1.3, 1.4);
    color: {{ section.settings.cta_heading_color | default: '#000000' }};
    margin: 0;
    padding: 0;
    word-wrap: break-word;
    hyphens: auto;
    justify-content: center;
  }

  .cta-description {
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(14px, 2vw, 20px);
    font-weight: 400;
    line-height: clamp(1.3, 1.4, 1.5);
    color: {{ section.settings.cta_text_color | default: '#000000' }};
    margin: 0;
    padding: 0;
    word-wrap: break-word;
    hyphens: auto;
    justify-content: center;
  }

  /* CTA Button - Fully Responsive */
  .cta-button-container {
    width: 100%;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: clamp(8px, 1.5vw, 12px) clamp(20px, 3vw, 35px);
    background-color: #ffffff;
    color: #374151;
    border: clamp(1px, 0.2vw, 2px) solid #374151;
    border-radius: clamp(8px, 1vw, 10px);
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(16px, 2.5vw, 24px);
    font-weight: 400;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
    box-sizing: border-box;
    min-height: clamp(40px, 6vw, 48px);
    word-wrap: break-word;
    hyphens: auto;
  }

  .cta-button:hover {
    background-color: #f9fafb;
    transform: translateY(-1px);
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
  }

  .cta-button:active {
    transform: translateY(0);
  }

  .cta-button:focus {
    outline: 3px solid rgba(59, 130, 246, 0.5);
    outline-offset: 2px;
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .cta-button {
      border-width: 3px;
    }
    .divider {
      height: 3px;
    }
    .featured-image {
      outline: 2px solid #000000;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .cta-button,
    .featured-image {
      transition: none;
    }
    .cta-button:hover,
    .featured-image:hover {
      transform: none;
    }
  }

  /* Print styles */
  @media print {
    .why-it-matters-section {
      background: white;
      padding: 20px 0;
      width: 100%;
      margin: 0;
    }
    .why-it-matters-container {
      padding: 0 20px;
      min-height: auto;
    }
    .content-area {
      flex-direction: column;
      gap: 20px;
      min-height: auto;
    }
    .image-container {
      height: 200px;
    }
    .cta-button {
      display: none;
    }
  }

  /* Ultra-wide screens (1920px+) */
  @media (min-width: 1920px) {
    .why-it-matters-container {
      max-width: 1600px;
      padding: clamp(60px, 6vh, 100px) clamp(60px, 4vw, 100px);
    }
    .content-area {
      gap: clamp(80px, 5vw, 100px);
      min-height: clamp(600px, 35vh, 700px);
    }
  }

  /* Small mobile devices (320px and below) */
  @media (max-width: 320px) {
    .why-it-matters-container {
      padding: 16px 12px;
      gap: 16px;
    }
    .content-area {
      gap: 12px;
    }
    .image-container {
      height: 180px;
    }
    .main-message p {
      font-size: 18px;
      line-height: 1.3;
    }
    .cta-button {
      font-size: 14px;
      padding: 8px 16px;
      min-height: 36px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Intersection Observer for section animation
    const whyItMattersSection = document.querySelector('.why-it-matters-section');
    const sectionTitle = document.querySelector('.section-title');
    const mainMessage = document.querySelector('.main-message');
    const ctaContent = document.querySelector('.cta-content');
    const ctaButton = document.querySelector('.cta-button');
    const featuredImage = document.querySelector('.featured-image, .image-placeholder');

    if (!whyItMattersSection) return;

    // Animation elements
    const animatedElements = [
      { element: sectionTitle, delay: 0 },
      { element: featuredImage, delay: 200 },
      { element: mainMessage, delay: 400 },
      { element: ctaContent, delay: 600 },
      { element: ctaButton, delay: 800 }
    ].filter(item => item.element);

    // Initialize elements with hidden state
    animatedElements.forEach(({ element }) => {
      element.style.opacity = '0';
      element.style.transform = 'translateY(40px)';
      element.style.transition = 'all 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
    });

    // Intersection Observer for scroll-triggered animations
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Animate elements with stagger delay
          animatedElements.forEach(({ element, delay }) => {
            setTimeout(() => {
              element.style.opacity = '1';
              element.style.transform = 'translateY(0)';
            }, delay);
          });

          // Unobserve after animation
          sectionObserver.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.2,
      rootMargin: '0px 0px -50px 0px'
    });

    // Observe the section
    sectionObserver.observe(whyItMattersSection);

    // Button interaction enhancement
    if (ctaButton) {
      ctaButton.addEventListener('mouseenter', function() {
        this.style.boxShadow = '0px 4px 12px rgba(0, 0, 0, 0.15)';
      });

      ctaButton.addEventListener('mouseleave', function() {
        this.style.boxShadow = '0px 2px 8px rgba(0, 0, 0, 0.1)';
      });

      // Smooth scroll functionality
      ctaButton.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('href').substring(1);
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    }

    // Responsive image loading optimization
    if (featuredImage && featuredImage.tagName === 'IMG') {
      featuredImage.addEventListener('load', function() {
        this.style.opacity = '1';
      });
    }

    // Cleanup function
    window.whyItMattersCleanup = () => {
      if (sectionObserver) sectionObserver.disconnect();
    };
  });

  // Handle page visibility changes
  document.addEventListener('visibilitychange', function() {
    const animatedElements = document.querySelectorAll('.why-it-matters-section [style*="transition"]');
    if (document.hidden) {
      animatedElements.forEach(element => {
        element.style.animationPlayState = 'paused';
      });
    } else {
      animatedElements.forEach(element => {
        element.style.animationPlayState = 'running';
      });
    }
  });
</script>

