{% comment %}
  Impact Cards Section - Individual Impact Card with Simple Magnifier Circle
  Features: Perfect circular image with small magnifier circle widget inside, text container below
{% endcomment %}

<section class="impact-cards-section" data-section-id="{{ section.id }}">
  <div class="impact-container">
    <!-- Header Section -->
    {% if section.settings.title != blank %}
      <div class="impact-header">
        <h2 class="impact-title">
          {{ section.settings.title }}
        </h2>
      </div>
    {% endif %}

    <!-- Cards Container -->
    <div class="impact-cards-container">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'impact_card' %}
            <div class="impact-card" {{ block.shopify_attributes }}>
              <!-- Card Container -->
              <div class="impact-card-container">
                <!-- Image Container with Simple Magnifier Circle Inside -->
                <div class="impact-image-container">
                  {% if block.settings.image %}
                    <!-- Main Circular Image -->
                    <div class="impact-card-image">
                      <img
                        src="{{ block.settings.image | img_url: '488x488' }}"
                        alt="{{ block.settings.image_alt | default: block.settings.title }}"
                        loading="lazy"
                      >
                    </div>
                    {% if block.settings.show_magnifier %}
                      <!-- Simple Magnifier Circle Widget -->
                      <div class="impact-magnifier-circle">
                        <svg width="50" height="50" viewBox="0 0 50 50" fill="none">
                          <circle cx="25" cy="25" r="7" stroke="rgba(255, 255, 255, 0.8)" stroke-width="1" fill="rgba(255, 255, 255, 0.1)"/>
                        </svg>
                      </div>
                    {% endif %}
                  {% else %}
                    <div class="impact-card-image-placeholder">
                      <svg width="200" height="200" viewBox="0 0 200 200" fill="none">
                        <rect width="200" height="200" rx="100" fill="#f3f4f6"/>
                        <path d="M50 150L87.5 112.5L125 150M150 50V150C150 155.523 145.523 160 140 160H60C54.4772 160 50 155.523 50 150V50C50 44.4772 54.4772 40 60 40H140C145.523 40 150 44.4772 150 50Z" stroke="#9ca3af" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="75" cy="75" r="10" stroke="#9ca3af" stroke-width="4"/>
                      </svg>
                      <p>Add impact image</p>
                    </div>
                  {% endif %}
                </div>

                <!-- Text Container Below Image -->
                <div class="impact-text-container">
                  <div class="impact-text-content">
                    <div class="impact-card-title">
                      {{ block.settings.title | default: 'Impact Title' }}
                    </div>
                    {% if block.settings.description %}
                      <div class="impact-card-description">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  /* Full viewport coverage */
  .impact-cards-section {
    width: 100vw;
    margin: 0;
    padding: clamp(40px, 8vh, 80px) 0;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
    box-sizing: border-box;
    overflow: hidden;
    min-height: auto;
  }

  .impact-container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 clamp(20px, 8vw, 144px);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 8vh, 80px);
    box-sizing: border-box;
    min-height: auto;
    justify-content: flex-start;
  }

  /* Header Styles */
  .impact-header {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    margin: 0;
    padding: 0;
  }

  .impact-title {
    font-family: 'Mitogen Display', 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 400;
    line-height: 1.2;
    color: {{ section.settings.title_color | default: '#ec4899' }};
    margin: 0;
    padding: 0;
  }

  /* Cards Container */
  .impact-cards-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(30px, 5vw, 60px);
    align-items: start;
    justify-items: center;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  /* Desktop: 2 columns */
  @media (min-width: 1025px) {
    .impact-cards-container {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(40px, 5vw, 60px);
      max-width: 1000px;
      margin: 0 auto;
    }
  }

  /* Tablet: 2 columns with smaller gap */
  @media (min-width: 769px) and (max-width: 1024px) {
    .impact-cards-container {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(30px, 4vw, 40px);
    }
  }

  /* Mobile: 1 column */
  @media (max-width: 768px) {
    .impact-cards-section {
      min-height: auto;
      padding: clamp(30px, 6vh, 50px) 0;
    }

    .impact-container {
      min-height: auto;
      justify-content: flex-start;
      gap: clamp(30px, 6vh, 40px);
    }

    .impact-cards-container {
      grid-template-columns: 1fr;
      gap: clamp(24px, 5vw, 32px);
    }
  }

  /* Impact Card */
  .impact-card {
    width: 100%;
    max-width: 450px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
  }

  .impact-card-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    box-sizing: border-box;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  /* Image Container - Contains perfect circular image and magnifier circle */
  .impact-image-container {
    position: relative;
    width: clamp(250px, 55vw, 400px);
    height: clamp(250px, 55vw, 400px);
    margin-bottom: clamp(-30px, -5vw, -40px);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Main Perfect Circular Image */
  .impact-card-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    margin: 0;
    padding: 0;
  }

  .impact-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    margin: 0;
    padding: 0;
  }

  .impact-card-image-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #f9fafb;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    color: #6b7280;
    font-family: 'Mitogen Display', 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(14px, 2vw, 16px);
    margin: 0;
    padding: 0;
  }

  /* Simple Magnifier Circle - Small circle with 1 stroke */
  .impact-magnifier-circle {
    position: absolute;
    top: clamp(25px, 6%, 40px);
    right: clamp(35px, 10%, 60px);
    width: clamp(40px, 8vw, 50px);
    height: clamp(40px, 8vw, 50px);
    z-index: 2;
    pointer-events: none;
  }

  .impact-magnifier-circle svg {
    width: 100%;
    height: 100%;
  }

  /* Text Container - White card below image */
  .impact-text-container {
    width: 100%;
    max-width: clamp(250px, 55vw, 400px);
    background: #ffffff;
    border-radius: 10px;
    box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);
    flex-shrink: 0;
    z-index: 1;
    position: relative;
    margin: 0;
    padding: clamp(16px, 3vw, 24px);
    box-sizing: border-box;
  }

  .impact-text-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 2vw, 12px);
    padding: clamp(16px, 3vw, 24px);
    box-sizing: border-box;
    width: 100%;
    text-align: center;
    font-family: 'Serotiva', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #000000;
  }

  .impact-card-title {
    font-size: clamp(20px, 3.5vw, 28px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
    flex-shrink: 0;
    word-wrap: break-word;
    hyphens: auto;
    overflow-wrap: break-word;
    max-width: 100%;
  }

  .impact-card-description {
    font-size: clamp(14px, 2.2vw, 18px);
    font-weight: 400;
    line-height: 1.4;
    margin: 0;
    width: 100%;
    flex-shrink: 0;
    word-wrap: break-word;
    hyphens: auto;
    overflow-wrap: break-word;
    text-align: center;
    max-width: 100%;
  }

  /* Mobile specific adjustments */
  @media (max-width: 480px) {
    .impact-image-container {
      width: clamp(220px, 70vw, 280px);
      height: clamp(220px, 70vw, 280px);
      margin-bottom: clamp(-25px, -4vw, -30px);
    }

    .impact-text-container {
      max-width: clamp(220px, 70vw, 280px);
      padding: clamp(12px, 2.5vw, 16px);
    }

    .impact-text-content {
      padding: clamp(12px, 2.5vw, 16px);
      gap: clamp(6px, 1.5vw, 8px);
    }

    .impact-card-title {
      font-size: clamp(18px, 4vw, 22px);
    }

    .impact-card-description {
      font-size: clamp(13px, 3vw, 16px);
      line-height: 1.3;
    }

    .impact-magnifier-circle {
      top: clamp(20px, 5%, 30px);
      right: clamp(25px, 8%, 40px);
      width: clamp(35px, 7vw, 40px);
      height: clamp(35px, 7vw, 40px);
    }
  }

  /* Accessibility */
  .impact-card-image img:focus {
    outline: 3px solid rgba(59, 130, 246, 0.5);
    outline-offset: 2px;
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .impact-text-container {
      border: 2px solid #000000;
    }
    .impact-magnifier-circle svg circle {
      stroke: #ffffff;
      fill: rgba(255, 255, 255, 0.3);
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .impact-card-image img {
      transition: none;
    }
  }

  /* Print styles */
  @media print {
    .impact-cards-section {
      background: white;
      padding: 20px 0;
      width: 100%;
      margin: 0;
    }
    .impact-container {
      padding: 0 20px;
      min-height: auto;
    }
    .impact-cards-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .impact-card {
      width: 100%;
      max-width: none;
      page-break-inside: avoid;
      margin-bottom: 20px;
    }
    .impact-magnifier-circle {
      display: none;
    }
    .impact-image-container {
      width: 200px;
      height: 200px;
    }
    .impact-text-container {
      max-width: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Intersection Observer for impact cards animation
    const impactCards = document.querySelectorAll('.impact-card');

    if (impactCards.length > 0) {
      const cardObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.style.opacity = '1';
              entry.target.style.transform = 'translateY(0)';
            }, index * 150);
            cardObserver.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      // Initialize cards with hidden state
      impactCards.forEach((card) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(40px)';
        card.style.transition = 'all 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
        cardObserver.observe(card);
      });
    }

    // Title animation
    const impactTitle = document.querySelector('.impact-title');
    if (impactTitle) {
      impactTitle.style.opacity = '0';
      impactTitle.style.transform = 'translateY(30px)';
      impactTitle.style.transition = 'all 0.8s cubic-bezier(0.4, 0, 0.2, 1)';

      const titleObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
            titleObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });

      titleObserver.observe(impactTitle);
    }

    // Dynamic text sizing based on content length
    const impactCardTitles = document.querySelectorAll('.impact-card-title');
    const impactCardDescriptions = document.querySelectorAll('.impact-card-description');

    function adjustImpactTextSize() {
      impactCardTitles.forEach(title => {
        const textLength = title.textContent.length;
        if (textLength > 30) {
          title.style.fontSize = 'clamp(18px, 3vw, 24px)';
        }
      });

      impactCardDescriptions.forEach(desc => {
        const textLength = desc.textContent.length;
        if (textLength > 150) {
          desc.style.fontSize = 'clamp(13px, 2vw, 16px)';
          desc.style.lineHeight = '1.3';
        }
      });
    }

    adjustImpactTextSize();

    // Re-adjust on window resize
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(adjustImpactTextSize, 250);
    });
  });
</script>

