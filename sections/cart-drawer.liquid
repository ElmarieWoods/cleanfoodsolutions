<div class="cart-drawer" id="cart-drawer" data-cart-drawer>
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title">Your Cart</h2>
    <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="Close cart">
      {% render 'icon-x' %}
    </button>
  </div>

  <div class="cart-drawer__content">
    <!-- Empty State -->
    <div class="cart-drawer__empty" data-cart-empty>
      <div class="cart-drawer__empty-icon">
        {% render 'icon-cart' %}
      </div>
      <h3 class="cart-drawer__empty-title">Your cart is empty</h3>
      <p class="cart-drawer__empty-text">Add some products to get started!</p>
      <button type="button" class="btn btn--primary" data-cart-drawer-close>
        Continue Shopping
      </button>
    </div>

    <!-- Cart Items -->
    <div class="cart-drawer__items" data-cart-items style="display: none;">
      <!-- Items will be populated by JavaScript -->
    </div>
  </div>

  <!-- Cart Footer -->
  <div class="cart-drawer__footer" data-cart-footer style="display: none;">
    <div class="cart-drawer__total">
      <div class="cart-drawer__total-row">
        <span class="cart-drawer__total-label">Subtotal</span>
        <span class="cart-drawer__total-price" data-cart-total>$0.00</span>
      </div>
      <p class="cart-drawer__total-note">Shipping and taxes calculated at checkout</p>
    </div>
    
    <div class="cart-drawer__actions">
      <a href="{{ routes.cart_url }}" class="btn btn--secondary btn--full">View Cart</a>
      <button type="button" class="btn btn--primary btn--full" onclick="window.location.href='{{ routes.cart_url }}'">
        Checkout
      </button>
    </div>
  </div>
</div>

<style>
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 400px;
    height: 100vh;
    background: white;
    z-index: 2147483647;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
  }

  .cart-drawer.is-active {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .cart-drawer__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground);
  }

  .cart-drawer__close {
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
  }

  .cart-drawer__close:hover {
    color: var(--color-foreground);
  }

  .cart-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  .cart-drawer__empty {
    text-align: center;
    padding: 40px 20px;
  }

  .cart-drawer__empty-icon {
    margin-bottom: 20px;
    opacity: 0.3;
  }

  .cart-drawer__empty-icon svg {
    width: 64px;
    height: 64px;
  }

  .cart-drawer__empty-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 10px 0;
    color: var(--color-foreground);
  }

  .cart-drawer__empty-text {
    color: var(--color-foreground-light);
    margin: 0 0 30px 0;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr auto auto;
    gap: 15px;
    align-items: start;
    padding: 15px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-item:last-child {
    border-bottom: none;
  }

  .cart-item__image {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-secondary);
  }

  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__details {
    min-width: 0;
  }

  .cart-item__title {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 5px 0;
    color: var(--color-foreground);
    line-height: 1.3;
  }

  .cart-item__variant {
    font-size: 0.8rem;
    color: var(--color-foreground-light);
    margin: 0 0 8px 0;
  }

  .cart-item__price {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .cart-item__unit-price {
    display: block;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-foreground-light);
    margin-top: 2px;
  }

  .cart-item__quantity {
    display: flex;
    align-items: center;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
  }

  .quantity-btn {
    background: white;
    border: none;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 14px;
    color: var(--color-foreground);
    transition: background-color var(--transition-fast);
  }

  .quantity-btn:hover {
    background: var(--color-secondary);
  }

  .quantity-input {
    border: none;
    width: 50px;
    height: 32px;
    text-align: center;
    font-size: 14px;
    background: white;
    border-left: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
  }

  .quantity-input:focus {
    outline: none;
    background: var(--color-secondary);
  }

  .cart-item__remove {
    display: flex;
    align-items: flex-start;
  }

  .cart-item__remove-btn {
    background: none;
    border: none;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 18px;
    color: var(--color-foreground-light);
    transition: color var(--transition-fast);
    border-radius: 4px;
  }

  .cart-item__remove-btn:hover {
    color: var(--color-error);
    background: rgba(239, 68, 68, 0.1);
  }

  .cart-drawer__footer {
    padding: 20px;
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
    background: white;
  }

  .cart-drawer__total {
    margin-bottom: 20px;
  }

  .cart-drawer__total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .cart-drawer__total-label {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .cart-drawer__total-price {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .cart-drawer__total-note {
    font-size: 0.8rem;
    color: var(--color-foreground-light);
    margin: 0;
  }

  .cart-drawer__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Mobile optimizations */
  @media (max-width: 768px) {
    .cart-drawer {
      max-width: 100%;
      width: 100%;
    }

    .cart-item {
      grid-template-columns: 60px 1fr auto;
      gap: 12px;
    }

    .cart-item__image {
      width: 60px;
      height: 60px;
    }

    .cart-item__remove {
      grid-column: 3;
      grid-row: 1;
    }

    .cart-item__quantity {
      grid-column: 1 / -1;
      justify-content: center;
      margin-top: 10px;
    }
  }

  /* Accessibility */
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* Loading states */
  .cart-item.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .cart-drawer.loading .cart-drawer__content {
    position: relative;
  }

  .cart-drawer.loading .cart-drawer__content::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 32px;
    height: 32px;
    border: 3px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotate(360deg); }
  }

  /* Button styles */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border: 2px solid transparent;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 44px;
  }

  .btn--primary {
    background: #ec4899;
    color: white;
    border-color: #ec4899;
  }

  .btn--primary:hover {
    background: #db2777;
    border-color: #db2777;
  }

  .btn--secondary {
    background: transparent;
    color: #ec4899;
    border-color: #ec4899;
  }

  .btn--secondary:hover {
    background: #ec4899;
    color: white;
  }

  .btn--full {
    width: 100%;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const cartDrawer = document.getElementById('cart-drawer');
  if (!cartDrawer) return;
  
  const cartDrawerOverlay = document.getElementById('cart-drawer-overlay');
  const cartDrawerClose = cartDrawer.querySelector('.cart-drawer__close');
  
  // Open cart drawer
  function openCartDrawer() {
    cartDrawer.classList.add('is-active');
    if (cartDrawerOverlay) {
      cartDrawerOverlay.style.visibility = 'visible';
      cartDrawerOverlay.style.opacity = '1';
    }
    document.body.style.overflow = 'hidden';
  }
  
  // Close cart drawer
  function closeCartDrawer() {
    cartDrawer.classList.remove('is-active');
    if (cartDrawerOverlay) {
      cartDrawerOverlay.style.visibility = 'hidden';
      cartDrawerOverlay.style.opacity = '0';
    }
    document.body.style.overflow = '';
  }
  
  // Event listeners
  if (cartDrawerOverlay) {
    cartDrawerOverlay.addEventListener('click', closeCartDrawer);
  }
  if (cartDrawerClose) {
    cartDrawerClose.addEventListener('click', closeCartDrawer);
  }
  
  // Handle quantity changes
  cartDrawer.addEventListener('click', function(e) {
    if (e.target.closest('.quantity-btn--plus')) {
      const input = e.target.closest('.cart-item__quantity').querySelector('.quantity-input');
      const currentValue = parseInt(input.value) || 0;
      const newValue = currentValue + 1;
      input.value = newValue;
      updateCartItem(input.dataset.line, newValue);
    }
    
    if (e.target.closest('.quantity-btn--minus')) {
      const input = e.target.closest('.cart-item__quantity').querySelector('.quantity-input');
      const currentValue = parseInt(input.value) || 0;
      if (currentValue > 0) {
        const newValue = currentValue - 1;
        input.value = newValue;
        updateCartItem(input.dataset.line, newValue);
      }
    }
    
    if (e.target.closest('.cart-item__remove')) {
      const line = e.target.closest('.cart-item__remove').dataset.line;
      updateCartItem(line, 0);
    }
  });
  
  // Handle direct input changes
  cartDrawer.addEventListener('change', function(e) {
    if (e.target.classList.contains('quantity-input')) {
      const value = Math.max(0, parseInt(e.target.value) || 0);
      e.target.value = value;
      updateCartItem(e.target.dataset.line, value);
    }
  });
  
  // Update cart item function
  function updateCartItem(line, quantity) {
    fetch('{{ routes.cart_change_url }}', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        line: parseInt(line),
        quantity: quantity
      })
    })
    .then(response => response.json())
    .then(cart => {
      // Update cart counter with exact count from API
      updateCartCounter(cart.item_count);
      
      // Refresh cart drawer content
      if (cart.item_count === 0) {
        closeCartDrawer();
      } else {
        refreshCartDrawer();
      }
    })
    .catch(error => {
      console.error('Error updating cart:', error);
    });
  }
  
  // Update cart counter function - uses exact API count
  function updateCartCounter(exactCount) {
    const cartBadges = document.querySelectorAll('[data-cart-count], .cart-badge, .cart-count');
    cartBadges.forEach(badge => {
      badge.textContent = exactCount;
      badge.style.display = exactCount > 0 ? 'block' : 'none';
      
      // Add animation
      badge.classList.add('animate');
      setTimeout(() => badge.classList.remove('animate'), 600);
    });
  }
  
  // Refresh cart drawer content
  function refreshCartDrawer() {
    fetch('{{ routes.cart_url }}?section_id=cart-drawer')
      .then(response => response.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newContent = doc.querySelector('#cart-drawer');
        if (newContent) {
          const newItems = newContent.querySelector('.cart-drawer__items');
          const currentItems = cartDrawer.querySelector('.cart-drawer__items');
          
          const newFooter = newContent.querySelector('.cart-drawer__footer');
          const currentFooter = cartDrawer.querySelector('.cart-drawer__footer');
          
          if (newItems && currentItems) {
            currentItems.innerHTML = newItems.innerHTML;
          }
          
          if (newFooter && currentFooter) {
            currentFooter.innerHTML = newFooter.innerHTML;
          } else if (newFooter && !currentFooter) {
            cartDrawer.querySelector('.cart-drawer__content').appendChild(newFooter.cloneNode(true));
          }
        }
      })
      .catch(error => {
        console.error('Error refreshing cart drawer:', error);
      });
  }
  
  // Global function to open cart drawer
  window.openCartDrawer = openCartDrawer;
  
  // Listen for cart updates from other parts of the site
  document.addEventListener('cart:updated', function(e) {
    if (e.detail && typeof e.detail.item_count === 'number') {
      updateCartCounter(e.detail.item_count);
    }
  });
});
</script>
