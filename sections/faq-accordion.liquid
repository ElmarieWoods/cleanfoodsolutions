      "id": "title_color",
      "label": "Title Color",
      "default": "#ec4899"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question Text Color",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer Text Color",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover Background Color",
      "default": "#E3F4F4"
    },
    {
