        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
      }

      // Enhanced cart counter fix - prevents multiple increments
      window.cartCounterFix = {
        isUpdating: false,
        
        updateCartCount: function(count) {
          if (this.isUpdating) return;
          this.isUpdating = true;
          
          const countElements = document.querySelectorAll('[data-cart-count], .cart-badge, .cart-count');
          countElements.forEach(function(element) {
            if (element) {
              element.textContent = count || '0';
              if (count === 0 || !count) {
                element.classList.add('hidden');
                element.style.display = 'none';
              } else {
                element.classList.remove('hidden');
                element.style.display = '';
              }
            }
          });
          
          setTimeout(() => {
            this.isUpdating = false;
          }, 100);
        },

        // Handle cart updates with exact count from API
        handleCartUpdate: function(response) {
          if (response && typeof response.item_count !== 'undefined') {
            // Use the exact cart count from the response
            this.updateCartCount(response.item_count);
          } else {
            // Fetch fresh cart data if response doesn't have count
            fetch('/cart.js')
              .then(function(res) { return res.json(); })
              .then(function(cart) {
                window.cartCounterFix.updateCartCount(cart.item_count);
              })
              .catch(function(error) {
                console.error('Error fetching cart:', error);
              });
          }
        }
      };

      // Initialize cart count on page load
      document.addEventListener('DOMContentLoaded', function() {
        fetch('/cart.js')
          .then(function(response) { return response.json(); })
          .then(function(cart) {
            window.cartCounterFix.updateCartCount(cart.item_count);
          })
          .catch(function(error) {
            console.error('Error initializing cart count:', error);
          });
      });
    </script>

