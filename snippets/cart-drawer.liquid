<div id="cart-drawer-overlay" class="cart-drawer-overlay"></div>

<div id="cart-drawer" class="cart-drawer" data-cart-drawer>
  <div class="cart-drawer-container">
    <div class="cart-drawer-header">
      <h2 class="cart-drawer-title">Your Cart</h2>
      <button id="cart-drawer-close" class="cart-drawer-close" aria-label="Close cart">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="cart-drawer-content">
      {% if cart.item_count > 0 %}
        <div class="cart-drawer-items" id="cart-drawer-items">
          {% for item in cart.items %}
            <div class="cart-drawer-item" data-line="{{ forloop.index }}">
              <div class="cart-drawer-item__image">
                {% if item.image %}
                  <img src="{{ item.image | img_url: '120x120' }}" alt="{{ item.title | escape }}" loading="lazy">
                {% else %}
                  <div class="cart-drawer-item__image-placeholder">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21,15 16,10 5,21"/>
                    </svg>
                  </div>
                {% endif %}
              </div>

              <div class="cart-drawer-item__details">
                <h3 class="cart-drawer-item__title">{{ item.product.title }}</h3>
                {% unless item.variant.title == 'Default Title' %}
                  <p class="cart-drawer-item__variant">{{ item.variant.title }}</p>
                {% endunless %}
                
                <div class="cart-drawer-item__price">
                  {% if item.original_price != item.final_price %}
                    <span class="cart-drawer-item__price-original">{{ item.original_price | money }}</span>
                    <span class="cart-drawer-item__price-final">{{ item.final_price | money }}</span>
                  {% else %}
                    <span class="cart-drawer-item__price-final">{{ item.final_price | money }}</span>
                  {% endif %}
                </div>

                <div class="cart-drawer-item__bottom">
                  <div class="quantity-selector">
                    <button class="quantity-selector__btn" data-action="decrease" data-line="{{ forloop.index }}" aria-label="Decrease quantity">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </button>
                    <input type="number" class="quantity-selector__input" value="{{ item.quantity }}" min="1" data-line="{{ forloop.index }}" readonly>
                    <button class="quantity-selector__btn" data-action="increase" data-line="{{ forloop.index }}" aria-label="Increase quantity">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </button>
                  </div>
                  <button class="cart-drawer-item__remove" data-line="{{ forloop.index }}" aria-label="Remove item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="3,6 5,6 21,6"></polyline>
                      <path d="m19,6v14a2,2 0 0,1 -2,2H7a2,2 0 0,1 -2,-2V6m3,0V4a2,2 0 0,1 2,-2h4a2,2 0 0,1 2,2v2"></path>
                      <line x1="10" y1="11" x2="10" y2="17"></line>
                      <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-drawer-footer">
          <div class="cart-drawer-subtotal">
            <span class="cart-drawer-subtotal__label">Subtotal:</span>
            <span class="cart-drawer-subtotal__amount">{{ cart.total_price | money }}</span>
          </div>
          
          <div class="cart-drawer-actions">
            <a href="/cart" class="btn btn--secondary cart-drawer-btn">View Cart</a>
            <button type="submit" name="add" class="btn btn--primary cart-drawer-btn" onclick="window.location.href='/checkout'">
              Checkout
            </button>
          </div>
          
          <form id="cart-drawer-form" action="/cart" method="post" novalidate></form>
        </div>
      {% else %}
        <div class="cart-drawer-empty">
          <div class="cart-drawer-empty__icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="m1,1h4l2.68,13.39a2,2 0 0,0 2,1.61h9.72a2,2 0 0,0 2,-1.61L23,6H6"></path>
            </svg>
          </div>
          <h3 class="cart-drawer-empty__title">Your cart is empty</h3>
          <p class="cart-drawer-empty__text">Add some products to get started!</p>
          <a href="/collections/all" class="btn btn--primary">Continue Shopping</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  /* Cart Drawer Styles with Brand Fonts */
  .cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .cart-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: min(400px, 90vw);
    height: 100%;
    background: #ffffff;
    z-index: 9999;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
  }

  .cart-drawer.is-active {
    transform: translateX(0);
  }

  .cart-drawer-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
  }

  .cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
    flex-shrink: 0;
  }

  .cart-drawer-title {
    font-family: 'Mitogen Display', Arial, Helvetica, sans-serif !important;
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0;
    color: #1f2937;
  }

  .cart-drawer-close {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #6b7280;
    transition: color 0.2s ease;
    border-radius: 4px;
  }

  .cart-drawer-close:hover {
    color: #1f2937;
    background: #f3f4f6;
  }

  .cart-drawer-content {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer-items {
    flex: 1;
    padding: 1rem 1.5rem;
  }

  .cart-drawer-item {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid #f3f4f6;
  }

  .cart-drawer-item:last-child {
    border-bottom: none;
  }

  .cart-drawer-item__image {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 8px;
    overflow: hidden;
    background: #f9fafb;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer-item__image-placeholder {
    color: #9ca3af;
  }

  .cart-drawer-item__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-drawer-item__title {
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    font-size: 0.875rem;
    font-weight: 500;
    color: #1f2937;
    margin: 0;
    line-height: 1.3;
  }

  .cart-drawer-item__variant {
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    font-size: 0.75rem;
    color: #6b7280;
    margin: 0;
  }

  .cart-drawer-item__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-drawer-item__price-original {
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    font-size: 0.875rem;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .cart-drawer-item__price-final {
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1f2937;
  }

  .cart-drawer-item__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    overflow: hidden;
  }

  .quantity-selector__btn {
    background: #f9fafb;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #6b7280;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quantity-selector__btn:hover {
    background: #f3f4f6;
    color: #1f2937;
  }

  .quantity-selector__input {
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    border: none;
    width: 50px;
    text-align: center;
    padding: 0.5rem 0.25rem;
    font-size: 0.875rem;
    background: #ffffff;
  }

  .cart-drawer-item__remove {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #ef4444;
    transition: all 0.2s ease;
    border-radius: 4px;
  }

  .cart-drawer-item__remove:hover {
    background: #fef2f2;
    color: #dc2626;
  }

  .cart-drawer-footer {
    padding: 1.5rem;
    border-top: 1px solid #e5e7eb;
    flex-shrink: 0;
    background: #ffffff;
  }

  .cart-drawer-subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .cart-drawer-subtotal__label {
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    font-size: 1rem;
    color: #6b7280;
  }

  .cart-drawer-subtotal__amount {
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    font-size: 1.125rem;
    font-weight: 600;
    color: #1f2937;
  }

  .cart-drawer-actions {
    display: flex;
    gap: 0.75rem;
  }

  .cart-drawer-btn {
    flex: 1;
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    text-align: center;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    transition: all 0.2s ease;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .btn--secondary {
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
  }

  .btn--secondary:hover {
    background: #e5e7eb;
    color: #1f2937;
  }

  .btn--primary {
    background: #3b82f6;
    color: white;
    border: 1px solid #3b82f6;
  }

  .btn--primary:hover {
    background: #2563eb;
    border-color: #2563eb;
  }

  .cart-drawer-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
    height: 100%;
  }

  .cart-drawer-empty__icon {
    color: #d1d5db;
    margin-bottom: 1rem;
  }

  .cart-drawer-empty__title {
    font-family: 'Mitogen Display', Arial, Helvetica, sans-serif !important;
    font-size: 1.25rem;
    font-weight: 400;
    color: #1f2937;
    margin: 0 0 0.5rem 0;
  }

  .cart-drawer-empty__text {
    font-family: 'Serotiva', Arial, Helvetica, sans-serif !important;
    color: #6b7280;
    margin: 0 0 1.5rem 0;
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .cart-drawer {
      width: 100vw;
    }

    .cart-drawer-header {
      padding: 1rem;
    }

    .cart-drawer-items {
      padding: 0.75rem 1rem;
    }

    .cart-drawer-footer {
      padding: 1rem;
    }

    .cart-drawer-actions {
      flex-direction: column;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const cartDrawer = document.getElementById('cart-drawer');
  const cartDrawerOverlay = document.getElementById('cart-drawer-overlay');
  const cartDrawerClose = document.getElementById('cart-drawer-close');
  const cartDrawerToggle = document.getElementById('cart-drawer-toggle');

  // Open cart drawer
  function openCartDrawer() {
    cartDrawer.classList.add('is-active');
    cartDrawerOverlay.classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  // Close cart drawer
  function closeCartDrawer() {
    cartDrawer.classList.remove('is-active');
    cartDrawerOverlay.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  // Event listeners
  if (cartDrawerToggle) {
    cartDrawerToggle.addEventListener('click', openCartDrawer);
  }

  if (cartDrawerClose) {
    cartDrawerClose.addEventListener('click', closeCartDrawer);
  }

  if (cartDrawerOverlay) {
    cartDrawerOverlay.addEventListener('click', closeCartDrawer);
  }

  // Quantity controls
  document.addEventListener('click', function(e) {
    if (e.target.closest('.quantity-selector__btn')) {
      const button = e.target.closest('.quantity-selector__btn');
      const action = button.dataset.action;
      const line = button.dataset.line;
      const input = button.parentElement.querySelector('.quantity-selector__input');
      let quantity = parseInt(input.value);

      if (action === 'increase') {
        quantity++;
      } else if (action === 'decrease' && quantity > 1) {
        quantity--;
      }

      input.value = quantity;
      updateCartQuantity(line, quantity);
    }

    if (e.target.closest('.cart-drawer-item__remove')) {
      const button = e.target.closest('.cart-drawer-item__remove');
      const line = button.dataset.line;
      updateCartQuantity(line, 0);
    }
  });

  // Update cart quantity
  function updateCartQuantity(line, quantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        line: line,
        quantity: quantity
      })
    })
    .then(response => response.json())
    .then(data => {
      // Reload the page to update cart
      window.location.reload();
    })
    .catch(error => {
      console.error('Error updating cart:', error);
    });
  }

  // Expose functions globally
  window.openCartDrawer = openCartDrawer;
  window.closeCartDrawer = closeCartDrawer;
});
</script>
