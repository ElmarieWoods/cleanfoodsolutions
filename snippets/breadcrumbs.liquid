{% comment %}
  Breadcrumbs Snippet
  Usage: {% render 'breadcrumbs' %}
{% endcomment %}

{% unless template == 'index' %}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li class="breadcrumb-item">
        <a href="{{ routes.root_url }}" class="breadcrumb-link">
          <svg class="breadcrumb-home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9,22 9,12 15,12 15,22"></polyline>
          </svg>
          <span class="sr-only">Home</span>
        </a>
      </li>

      {% case template %}
        {% when 'page' %}
          <li class="breadcrumb-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </li>
          <li class="breadcrumb-item breadcrumb-current">
            <span class="breadcrumb-text">{{ page.title }}</span>
          </li>

        {% when 'product' %}
          <li class="breadcrumb-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </li>
          <li class="breadcrumb-item">
            <a href="{{ collections.all.url }}" class="breadcrumb-link">
              <span class="breadcrumb-text">Products</span>
            </a>
          </li>
          <li class="breadcrumb-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </li>
          <li class="breadcrumb-item breadcrumb-current">
            <span class="breadcrumb-text">{{ product.title }}</span>
          </li>

        {% when 'collection' %}
          <li class="breadcrumb-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </li>
          <li class="breadcrumb-item breadcrumb-current">
            <span class="breadcrumb-text">{{ collection.title }}</span>
          </li>

        {% when 'blog' %}
          <li class="breadcrumb-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </li>
          <li class="breadcrumb-item breadcrumb-current">
            <span class="breadcrumb-text">{{ blog.title }}</span>
          </li>

        {% when 'article' %}
          <li class="breadcrumb-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </li>
          <li class="breadcrumb-item">
            <a href="{{ blog.url }}" class="breadcrumb-link">
              <span class="breadcrumb-text">{{ blog.title }}</span>
            </a>
          </li>
          <li class="breadcrumb-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </li>
          <li class="breadcrumb-item breadcrumb-current">
            <span class="breadcrumb-text">{{ article.title }}</span>
          </li>
      {% endcase %}
    </ol>
  </nav>
{% endunless %}
